{
  "name": "belougas-ticketing-system",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "0_resetDb": "node scripts/00-initialization/reset-db.js --force",
    "1_registerVenue": "node scripts/01-venue-management/register-venue.js patinoire-blagnac 'Patinoire de Blagnac' data/patinoire-blagnac.svg --overwrite",
    "2_importSeats": "node scripts/01-venue-management/import-seats.js --venue=patinoire-blagnac",
    "3_instantiateVenueForSeason": "node scripts/03-season-management/instantiate-venue-for-season.js 2025-2026 patinoire-blagnac",
    "4_updateSeasonPhaseRenewal": "node scripts/03-season-management/upsert-season.js 2025-2026 --name='Saison 2025-2026' --enable-renewal",
    "5_importCatalogTarifs": "node scripts/02-tariff-management/import-tariffs.js data/tariff_catalog.csv",
    "6_importTariffPrices": "node scripts/02-tariff-management/import-tariff-prices.js season-game data/prices_list.csv --venue=patinoire-blagnac",
    "7_instantiateTariffs": "node scripts/03-season-management/instantiate-tariffs.js 2025-2026 patinoire-blagnac --catalog=season-game --clear",
    "8_importRenewers": "node scripts/03-season-management/import-renewers-flat.js data/subscribers.csv 2025-2026 --venue=patinoire-blagnac",
    "9_provisionSeatsForRenewal": "node scripts/03-season-management/renewal-provision-seats.js 2025-2026 --venue=patinoire-blagnac",
    "10_exportRenewGroups": "node scripts/03-season-management/export-renew-groups.js 2025-2026 --venue=patinoire-blagnac  --out=renew-groups.csv --base=http://localhost:8080/", 
    "db:sync-indexes": "node scripts/sync-indexes.mjs",
    "db:verify-models": "node scripts/verify-models.mjs",
    "docs:build": "node scripts/docs/build-docs.js"
  },
  "dependencies": {
    "bts": "^1.0.3",
    "celebrate": "^15.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.2",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.13.0",
    "pino": "^9.3.2",
    "qrcode": "^1.5.3",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "cheerio": "^1.0.0-rc.12",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  }
}
