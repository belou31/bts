{
  "name": "belougas-ticketing-system",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",

    "seed": "node scripts/seed-dev.js",
    "test": "jest --runInBand",
    "lint": "eslint .",
    
    "0_resetDb": "node scripts/admin/reset-db.js --force",
    "1_registerVenue": "node scripts/venues/register-venue-with-plan.js patinoire-blagnac 'Patinoire de Blagnac' data/patinoire-blagnac.svg",
    "2_importSeats": "node scripts/venues/import-seats-from-svg.js patinoire-blagnac src/public/venues/patinoire-blagnac/plan.svg",
    "3_instanciateSeats4Season": "node scripts/venues/instantiate-seats-for-season.js 2025-2026 patinoire-blagnac",
    "4_updateSeasonPhaseRenewal": "node scripts/admin/upsert-season.js 2025-2026 --name='Saison 2025-2026' --enable-renewal",
    "5_importCatalogTarifs": "node scripts/tariffs/import-catalog.js data/tariff_catalog.csv",
    "6_importPricePerZone": "node scripts/pricing/import-zone-tariffs.js 2025-2026 patinoire-blagnac data/prices_matrix.csv",
    "7_importSubscribers": "node scripts/import-subscribers-flat.js data/subscribers.csv 2025-2026 --venue=patinoire-blagnac",
    "8_provisionSeatsForRenewal": "node scripts/renewal/provision-seats.js 2025-2026 --venue=patinoire-blagnac",
    "9_exportRenewGroups": "node scripts/export-renew-groups.js 2025-2026 --venue=patinoire-blagnac  --out=renew-groups.csv --base=http://localhost:8080/",

    "db:sync-indexes": "node scripts/sync-indexes.mjs",
    "db:verify-models": "node scripts/verify-models.mjs",
    "docs:build": "node scripts/docs/build-docs.js"
  },
  "dependencies": {
    "celebrate": "^15.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.2",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "cheerio": "^1.0.0-rc.12",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  }
}
