      <% } %>
    </section>
  <% } %>

  <% if (viewMode === 'monitor' && monitoring && !monitorTab) { %>
    <section class="card intro-card">
      <h2>Monitoring — Overview</h2>
      <p class="muted">Pick a view below, or use the dropdown above.</p>
      <ul class="intro-list">
        <% for (const ch of categoryChapters.monitor) { if (ch.id === 'overview') continue; %>
          <li>
            <a href="<%= ch.href %>"><%= ch.label %></a>
            <% if (ch.description) { %><span class="intro-item-desc"><%= ch.description %></span><% } %>
          </li>
        <% } %>
      </ul>
    </section>
  <% } %>

  <% if (viewMode === 'monitor' && monitoring && monitorTab) { %>

    <div class="monitoring-panel <%= monitorTab === 'custo' ? 'active' : '' %>" data-monitor-panel="custo">
      <div class="operations-grid io-layout io-layout-2col">
        <section class="card io-card">
          <div class="inputs-header">
            <h2>Fichiers data/ (lecture seule)</h2>
          </div>

          <%
            // Turns the flat {rel, name, size, mtime} listing into a nested
            // dir/file tree so the season/event/partner hierarchy under
            // data/customization (and data/templates) is visible at a
            // glance instead of read off dotted-looking flat paths.
            function buildFileTree(files) {
              const root = { type: 'dir', name: '', children: new Map(), fileCount: 0 };
              for (const file of (files || [])) {
                const parts = file.rel.split('/');
                let node = root;
                for (let i = 0; i < parts.length - 1; i++) {
                  const part = parts[i];
                  if (!node.children.has(part)) {
                    node.children.set(part, { type: 'dir', name: part, children: new Map(), fileCount: 0 });
                  }
                  node = node.children.get(part);
                  node.fileCount += 1;
                }
                node.children.set(parts[parts.length - 1], { type: 'file', name: parts[parts.length - 1], rel: file.rel, size: file.size, mtime: file.mtime });
              }
              const toArray = (node) => Array.from(node.children.values())
                .map(child => child.type === 'dir' ? Object.assign({}, child, { children: toArray(child) }) : child)
                .sort((a, b) => a.type !== b.type ? (a.type === 'dir' ? -1 : 1) : a.name.localeCompare(b.name));
              return toArray(root);
            }
            function renderFileTree(nodes, downloadPrefix) {
          %>
            <ul class="custo-tree">
            <% nodes.forEach(function (node) { %>
              <% if (node.type === 'dir') { %>
                <li class="custo-tree-dir">
                  <details open>
                    <summary><%= node.name %>/ <span class="file-meta">(<%= node.fileCount %>)</span></summary>
                    <% renderFileTree(node.children, downloadPrefix); %>
                  </details>
                </li>
              <% } else {
                   const dlUrl = urlFor('/admin/templates/download') + '?path=' + encodeURIComponent(downloadPrefix + node.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
              %>
                <li class="custo-tree-file">
                  <code><%= node.name %></code>
                  <span class="file-meta"><%= (node.size/1024).toFixed(1) %> KB</span>
                  <span class="file-meta"><%= new Date(node.mtime).toLocaleString() %></span>
                  <a class="btn btn-small" href="<%= dlUrl %>" download="<%= node.name %>">Télécharger</a>
                </li>
              <% } %>
            <% }); %>
            </ul>
          <% } %>

          <div class="io-subsection">
            <h3>JSON (data/customization)</h3>
            <% if (!customizationList || !customizationList.length) { %>
              <div class="muted">Aucune personnalisation détectée.</div>
            <% } else { %>
              <div class="scroll-limited">
                <% renderFileTree(buildFileTree(customizationList), 'data/customization/'); %>
              </div>
            <% } %>
          </div>

          <div class="io-subsection">
            <h3>Templates (data/templates)</h3>
            <% if (!dataTemplatesList || !dataTemplatesList.length) { %>
              <div class="muted">Aucun template détecté.</div>
            <% } else { %>
              <div class="scroll-limited">
                <% renderFileTree(buildFileTree(dataTemplatesList), 'data/templates/'); %>
              </div>
            <% } %>
          </div>

          <div class="io-subsection">
            <h3>Assets (data/assets)</h3>
            <% if (!dataAssetsList || !dataAssetsList.length) { %>
              <div class="muted">Aucun asset détecté.</div>
            <% } else { %>
              <div class="scroll-limited">
                <% renderFileTree(buildFileTree(dataAssetsList), 'data/assets/'); %>
              </div>
            <% } %>
          </div>
        </section>

        <section class="card io-card">
          <div class="inputs-header">
            <h2>Assets publics (public/dynamic)</h2>
          </div>

          <div class="io-subsection">
            <h3>Assets (public/dynamic/assets)</h3>
            <% if (!dynamicAssetsList || !dynamicAssetsList.length) { %>
              <div class="muted">Aucun asset dynamique pour le moment.</div>
            <% } else { %>
              <ul class="file-list scroll-limited">
                <% for (const file of dynamicAssetsList || []) {
                     const assetUrl = urlFor('/dynamic/assets/' + encodeURIComponent(file.rel));
                %>
                  <li>
                    <code><%= file.name %></code>
                    <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                    <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                    <a class="btn btn-small" href="<%= assetUrl %>" download="<%= file.name %>">Télécharger</a>
                  </li>
                <% } %>
              </ul>
            <% } %>
          </div>

          <div class="io-subsection">
            <h3>Lieux (public/dynamic/venues)</h3>
            <% if (!venueResources || !venueResources.length) { %>
              <div class="muted">Aucun plan ou vue détecté.</div>
            <% } else { %>
              <div class="scroll-limited">
                <ul class="custo-tree">
                  <% for (const venue of venueResources) {
                       const viewCount = (venue.views || []).length;
                  %>
                    <li class="custo-tree-dir">
                      <details open>
                        <summary><%= venue.venueSlug %>/ <span class="file-meta">(<%= venue.plan ? '1 plan' : '0 plan' %> + <%= viewCount %> vue<%= viewCount === 1 ? '' : 's' %>)</span></summary>
                        <ul class="custo-tree">
                          <% if (venue.plan) { const planUrl = urlFor('/' + venue.plan.rel); %>
                            <li class="custo-tree-file">
                              <code>plan.svg</code>
                              <span class="file-meta"><%= (venue.plan.size/1024).toFixed(1) %> KB</span>
                              <span class="file-meta"><%= new Date(venue.plan.mtime).toLocaleString() %></span>
                              <a class="btn btn-small" href="<%= planUrl %>" download="plan.svg">Télécharger</a>
                            </li>
                          <% } else { %>
                            <li class="custo-tree-file"><span class="file-meta muted">Plan manquant</span></li>
                          <% } %>
                          <% for (const view of (venue.views || [])) { const viewUrl = urlFor('/' + view.rel); %>
                            <li class="custo-tree-file">
                              <code><%= view.slug %>.svg</code>
                              <span class="file-meta"><%= (view.size/1024).toFixed(1) %> KB</span>
                              <span class="file-meta"><%= new Date(view.mtime).toLocaleString() %></span>
                              <a class="btn btn-small" href="<%= viewUrl %>" download="<%= view.slug %>.svg">Télécharger</a>
                            </li>
                          <% } %>
                        </ul>
                      </details>
                    </li>
                  <% } %>
                </ul>
              </div>
            <% } %>
          </div>
        </section>
      </div>
    </div>

    <div class="monitoring-panel <%= monitorTab === 'system' ? 'active' : '' %>" data-monitor-panel="system">
      <div class="monitoring-grid">
        <section class="card">
          <h2>Application</h2>
          <div>Host : <span class="mono"><%= monitoring.summary.serverInfo.host %></span></div>
          <div>Node : <%= monitoring.summary.serverInfo.nodeVersion %></div>
          <div>Env : <span class="pill"><%= monitoring.summary.serverInfo.env %></span></div>
          <div>Base path : <span class="mono"><%= monitoring.summary.serverInfo.basePath %></span></div>
        </section>

        <section class="card">
          <h2>MongoDB</h2>
          <div>État : <strong><%= monitoring.summary.mongoState %></strong></div>
          <% const mongoConn = monitoring.summary.mongoConnections; %>
          <% if (mongoConn) { %>
            <div>Connexions actives : <strong><%= mongoConn.current != null ? mongoConn.current : '—' %></strong><%= mongoConn.available != null ? ' / ' + mongoConn.available + ' disponibles' : '' %></div>
          <% } else { %>
            <div class="muted" style="margin-top:8px;">Nombre de connexions non disponible.</div>
          <% } %>
          <% const opCounters = monitoring.summary.mongoOpCounters; %>
          <% if (opCounters) { %>
            <div class="muted" style="margin-top:8px;">Opérations (depuis démarrage du serveur Mongo) :</div>
            <div class="mono">insert <%= opCounters.insert || 0 %> · query <%= opCounters.query || 0 %> · update <%= opCounters.update || 0 %> · delete <%= opCounters.delete || 0 %> · command <%= opCounters.command || 0 %></div>
          <% } %>
        </section>

        <section class="card">
          <h2>Activité</h2>
          <% const activity = monitoring.summary.requestActivity; %>
          <% if (activity) { %>
            <div>Requêtes concurrentes : <strong><%= activity.concurrentRequests %></strong> (pic : <%= activity.peakConcurrentRequests %>)</div>
            <div>Requêtes totales (depuis démarrage) : <%= activity.totalRequests %></div>
            <div class="muted" style="margin-top:4px;">Démarré <%= activity.startedAt ? new Date(activity.startedAt).toLocaleString() : '—' %></div>
          <% } %>
          <div style="margin-top:8px;">Workflows automatisés en cours : <strong><%= monitoring.summary.activeAutomationJobs != null ? monitoring.summary.activeAutomationJobs : '—' %></strong></div>
        </section>

        <section class="card">
          <h2>PM2</h2>
          <% if (monitoring.summary.pm2 && monitoring.summary.pm2.length) { %>
            <div class="scroll-table">
              <table>
                <tr><th>Process</th><th>Status</th><th>CPU</th><th>RAM</th><th>Restarts</th></tr>
                <% for (const p of monitoring.summary.pm2.slice(0, 8)) { %>
                  <tr>
                    <td><%= p.name %></td>
                    <td><%= p.status || '' %></td>
                    <td><%= p.cpu || 0 %>%</td>
                    <td><%= Math.round((p.mem || 0) / 1048576) %> MB</td>
                    <td><%= p.restarts || 0 %></td>
                  </tr>
                <% } %>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">PM2 non disponible.</div>
          <% } %>
        </section>

        <section class="card">
          <h2>Espace disque</h2>
          <% const disk = monitoring.summary.diskUsage; %>
          <% if (disk) { %>
            <div>Total : <%= (disk.sizeKB / (1024 * 1024)).toFixed(2) %> GB</div>
            <div>Utilisé : <%= (disk.usedKB / (1024 * 1024)).toFixed(2) %> GB (<%= disk.usedPct != null ? disk.usedPct + '%' : '—' %>)</div>
            <div>Libre : <%= (disk.availKB / (1024 * 1024)).toFixed(2) %> GB</div>
            <div class="muted mono" style="margin-top:8px;"><%= disk.filesystem || '' %></div>
          <% } else { %>
            <div class="empty-state">Non disponible.</div>
          <% } %>
        </section>
      </div>

      <div class="monitoring-grid">
        <section class="card">
          <h2>MongoDB — Datasets</h2>
          <% const dbCollections = monitoring.summary.dbCollections; %>
          <% if (dbCollections && dbCollections.length) { %>
            <div class="scroll-table">
              <table>
                <tr><th>Collection</th><th>Documents</th><th>Taille</th></tr>
                <% for (const c of dbCollections) { %>
                  <tr>
                    <td><code><%= c.name %></code></td>
                    <td><%= c.count != null ? c.count : '—' %></td>
                    <td><%= c.sizeBytes != null ? (c.sizeBytes / (1024 * 1024)).toFixed(2) + ' MB' : '—' %></td>
                  </tr>
                <% } %>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">Aucune collection détectée.</div>
          <% } %>
        </section>

        <section class="card">
          <h2>Logs récents</h2>
          <% const recentLogs = monitoring.summary.recentLogs; %>
          <% if (recentLogs && recentLogs.length) { %>
            <ul class="metrics-list scroll-limited">
              <% for (const entry of recentLogs) { %>
                <li><span class="pill"><%= entry.stream %></span><span class="mono"><%= entry.line %></span></li>
              <% } %>
            </ul>
          <% } else { %>
            <div class="empty-state">Aucun log récent disponible.</div>
          <% } %>
        </section>

        <section class="card">
          <h2>Routes les plus sollicitées</h2>
          <% const topRoutes = monitoring.summary.requestActivity && monitoring.summary.requestActivity.topRoutes; %>
          <% if (topRoutes && topRoutes.length) { %>
            <div class="scroll-table">
              <table>
                <tr><th>Méthode</th><th>Route</th><th>Appels</th></tr>
                <% for (const r of topRoutes) { %>
                  <tr>
                    <td><%= r.method %></td>
                    <td><code><%= r.path %></code></td>
                    <td><%= r.count %></td>
                  </tr>
                <% } %>
              </table>
            </div>
            <div class="muted" style="margin-top:8px;">Compteurs remis à zéro à chaque redémarrage du serveur.</div>
          <% } else { %>
            <div class="empty-state">Aucune requête comptabilisée depuis le démarrage.</div>
          <% } %>
        </section>
      </div>

      <section class="card">
        <h3>Jobs automatisés récents</h3>
        <% 
          const jobRows = [];
          for (const [scriptId, list] of Object.entries(automationJobs || {})) {
            (list || []).forEach(job => jobRows.push({ scriptId, job }));
          }
          jobRows.sort((a, b) => {
            const da = a.job.createdAt ? new Date(a.job.createdAt).getTime() : 0;
            const db = b.job.createdAt ? new Date(b.job.createdAt).getTime() : 0;
            return db - da;
          });
        %>
        <% if (jobRows.length) { %>
          <div class="scroll-table">
            <table>
              <thead>
                <tr>
                  <th>Script</th>
                  <th>ID</th>
                  <th>Statut</th>
                  <th>Mode</th>
                  <th>Résumé</th>
                  <th>Créé</th>
                </tr>
              </thead>
              <tbody>
                <% for (const row of jobRows) {
                     const job = row.job;
                     const summary = job?.result?.summary || job?.error?.message || '';
                     const createdLabel = job?.createdAt ? new Date(job.createdAt).toLocaleString() : '—';
                %>
                  <tr>
                    <td><%= row.scriptId %></td>
                    <td class="mono"><%= job.id ? job.id.slice(-6) : '—' %></td>
                    <td><%= job.status || '—' %></td>
                    <td><%= job.dryRun ? 'dry-run' : 'envoi' %></td>
                    <td><%= summary || '—' %></td>
                    <td><%= createdLabel %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">Aucun job récent.</div>
        <% } %>
      </section>
    </div>

    <div class="monitoring-panel <%= monitorTab === 'venue' ? 'active' : '' %>" data-monitor-panel="venue">
      <h3>Lieux</h3>
      <% if (monitoring.lists.venues && monitoring.lists.venues.length) { %>
        <div class="scroll-table" style="margin-bottom:16px;">
          <table>
            <tr><th>Slug</th><th>Nom</th><th>Zones</th><th>Sièges</th><th>Vues</th><th>Plan</th></tr>
            <% for (const v of monitoring.lists.venues) { %>
              <tr>
                <td><code><%= v.slug %></code></td>
                <td><%= v.name %></td>
                <td><%= v.zoneCount %></td>
                <td><%= v.seatCount %></td>
                <td><%= v.viewCount %></td>
                <td><%= v.hasPlan ? 'Oui' : 'Non' %></td>
              </tr>
            <% } %>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">Aucun lieu configuré.</div>
      <% } %>

      <h3>Détail des zones</h3>
      <% if (monitoring.lists.venues && monitoring.lists.venues.length) { %>
        <form method="get" class="inline-filter-form">
          <% if (token) { %><input type="hidden" name="token" value="<%= token %>"><% } %>
          <input type="hidden" name="monitorTab" value="venue">
          <label>
            Lieu
            <select name="monitorVenue" data-auto-submit="change">
              <% for (const v of monitoring.lists.venues) { %>
                <option value="<%= v.slug %>" <%= v.slug === monitoring.lists.selectedMonitorVenueSlug ? 'selected' : '' %>>
                  <%= v.slug %><%= v.name ? ' — ' + v.name : '' %>
                </option>
              <% } %>
            </select>
          </label>
          <noscript><button type="submit" class="btn btn-small">Afficher</button></noscript>
        </form>

        <% if (monitoring.lists.venueZoneDetails && monitoring.lists.venueZoneDetails.length) { %>
          <div class="scroll-table" style="margin-top:12px;">
            <table>
              <tr><th>Clé</th><th>Nom</th><th>Type</th><th>Accès</th><th>Capacité</th><th>Quota</th><th>Sièges</th><th>Active</th></tr>
              <% for (const z of monitoring.lists.venueZoneDetails) { %>
                <tr>
                  <td><code><%= z.key %></code></td>
                  <td><%= z.name || '—' %></td>
                  <td><%= z.type %></td>
                  <td><%= z.access %></td>
                  <td><%= z.capacity %></td>
                  <td><%= z.quota %></td>
                  <td><%= z.seatCount %></td>
                  <td><%= z.isActive ? 'Oui' : 'Non' %></td>
                </tr>
              <% } %>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state" style="margin-top:12px;">Aucune zone configurée pour ce lieu.</div>
        <% } %>
      <% } else { %>
        <div class="empty-state">Aucun lieu à afficher.</div>
      <% } %>
    </div>


    <div class="monitoring-panel <%= monitorTab === 'tariffs' ? 'active' : '' %>" data-monitor-panel="tariffs">
      <h3>Catalogue des tarifs</h3>
      <% if (monitoring.lists.tariffs && monitoring.lists.tariffs.length) { %>
        <div class="scroll-table" style="margin-bottom:16px;">
          <table>
            <tr><th>Code</th><th>Libellé</th><th>Actif</th><th>Table de prix</th><th>Champ requis</th></tr>
            <% for (const t of monitoring.lists.tariffs) { %>
              <tr>
                <td><code><%= t.code %></code></td>
                <td><%= t.label %></td>
                <td><%= t.active ? 'Oui' : 'Non' %></td>
                <td><%= t.priceTableKey || 'Global' %></td>
                <td><%= t.fieldLabel || t.requiresField || '—' %></td>
              </tr>
            <% } %>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">Aucun tarif disponible.</div>
      <% } %>

      <h3>Catalogues de prix (Tariff Price Catalog)</h3>
      <% if (monitoring.lists.tariffPriceCatalogGroups && monitoring.lists.tariffPriceCatalogGroups.length) { %>
        <div class="scroll-table" style="margin-bottom:16px;">
          <table>
            <tr><th>Catalogue</th><th>Lieu</th><th>Zones</th><th>Tarifs</th><th>Entrées</th><th>Devise</th></tr>
            <% for (const g of monitoring.lists.tariffPriceCatalogGroups) { %>
              <tr>
                <td><code><%= g.catalogSlug %></code></td>
                <td><%= g.venueSlug || '—' %></td>
                <td><%= g.zoneCount %></td>
                <td><%= g.tariffCount %></td>
                <td><%= g.entryCount %></td>
                <td><%= g.currency %></td>
              </tr>
            <% } %>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">Aucun catalogue de prix configuré.</div>
      <% } %>

      <h3>Aperçu d'un catalogue de prix</h3>
      <% if (monitoring.lists.tariffPriceCatalogGroups && monitoring.lists.tariffPriceCatalogGroups.length) { %>
        <form method="get" class="inline-filter-form">
          <% if (token) { %><input type="hidden" name="token" value="<%= token %>"><% } %>
          <input type="hidden" name="monitorTab" value="tariffs">
          <label>
            Catalogue
            <select name="catalogKey" data-auto-submit="change">
              <% for (const g of monitoring.lists.tariffPriceCatalogGroups) { %>
                <option value="<%= g.key %>" <%= g.key === monitoring.lists.selectedCatalogKey ? 'selected' : '' %>>
                  <%= g.catalogSlug %><%= g.venueSlug ? ' — ' + g.venueSlug : ' (global)' %>
                </option>
              <% } %>
            </select>
          </label>
          <noscript><button type="submit" class="btn btn-small">Afficher</button></noscript>
        </form>

        <% if (monitoring.lists.tariffPriceCatalogEntries && monitoring.lists.tariffPriceCatalogEntries.length) { %>
          <div class="scroll-table" style="margin-top:12px;">
            <table>
              <tr><th>Zone</th><th>Tarif</th><th>Prix</th><th>Prix partenaire</th></tr>
              <% for (const e of monitoring.lists.tariffPriceCatalogEntries) { %>
                <tr>
                  <td><code><%= e.zoneKey %></code></td>
                  <td><code><%= e.tariffCode %></code></td>
                  <td><%= (e.priceCents / 100).toLocaleString('fr-FR', { style: 'currency', currency: e.currency }) %></td>
                  <td><%= e.partnerPriceCents != null ? (e.partnerPriceCents / 100).toLocaleString('fr-FR', { style: 'currency', currency: e.currency }) : '—' %></td>
                </tr>
