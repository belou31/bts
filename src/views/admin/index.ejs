<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>BTS — Administration</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #fafafa;
      --fg: #222;
      --muted: #666;
      --border: #e2e2e2;
      --accent: #2360c6;
      --danger: #b3001e;
      --success: #0b7d2b;
      --warn: #b36b00;
      --card-bg: #fff;
    }
    * { box-sizing: border-box; }
    body {
      font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      margin: 24px;
      background: var(--bg);
      color: var(--fg);
      min-height: 100vh;
    }
    h1 { font-size: 20px; margin: 0 0 20px; }
    h2 { font-size: 16px; margin: 0 0 8px; }
    h3 { font-size: 15px; margin: 16px 0 8px; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      box-shadow: 0 1px 1px rgba(0,0,0,0.04);
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      border: 1px solid var(--border);
      padding: 6px 8px;
      text-align: left;
    }
    .pill {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      background: #eee;
      font-size: 12px;
    }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    .warn { color: var(--warn); }
    .danger { color: var(--danger); }
    .success { color: var(--success); }
    .btn {
      display: inline-block;
      margin-top: 8px;
      padding: 6px 10px;
      border: 1px solid var(--border);
      border-radius: 8px;
      text-decoration: none;
      color: inherit;
      background: #fff;
      font-weight: 500;
      transition: background 0.15s;
    }
    .btn:hover { background: #f3f6ff; }
    .btn-danger {
      color: var(--danger);
      border-color: #f4c2c2;
      background: #fff6f6;
    }
    .btn-danger:hover {
      background: #ffecec;
    }
    .btn-small { padding: 4px 8px; font-size: 12px; margin-left: 6px; margin-top: 0; }
    .btn-link { border: none; background: transparent; color: var(--accent); padding: 0; margin-left: 8px; cursor: pointer; font-weight: 500; }
    .btn-link:hover { text-decoration: underline; background: transparent; }
    .scripts-card {
      margin-top: 24px;
    }
    .intro-card { margin-top: 24px; }
    .intro-group { margin-top: 20px; }
    .intro-group:first-of-type { margin-top: 12px; }
    .intro-group h3 { margin: 0 0 2px 0; font-size: 15px; }
    .intro-group-desc { margin: 0 0 8px 0; font-size: 13px; }
    .intro-list { list-style: none; margin: 0; padding: 0; }
    .intro-list li { padding: 5px 0; border-bottom: 1px solid var(--border); display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
    .intro-list li:last-child { border-bottom: none; }
    .intro-list a { font-weight: 500; }
    .intro-item-desc { color: var(--muted); font-size: 13px; }
    .tab-stack {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .script-tab {
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: transparent;
      cursor: default;
      font: inherit;
      transition: background 0.15s, border-color 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .script-tab.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .script-group {
      display: none;
      gap: 16px;
    }
    .script-group.active { display: grid; }
    .script-item {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      background: #fff;
      box-shadow: 0 1px 1px rgba(0,0,0,0.03);
    }
    .script-item.danger {
      border-color: var(--danger);
    }
    .automation-jobs {
      margin-top: 16px;
      border-top: 1px solid var(--border);
      padding-top: 12px;
    }
    .automation-jobs-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }
    .automation-jobs table {
      font-size: 12px;
      border: 1px solid var(--border);
    }
    .automation-jobs thead th {
      background: #f7f9ff;
    }
    .automation-job-status {
      font-weight: 600;
      text-transform: uppercase;
    }
    .automation-jobs-empty {
      font-size: 12px;
      color: var(--muted);
      margin-top: 4px;
    }
    .automation-jobs tr.highlight {
      background: #fff7d6;
      transition: background 0.8s ease;
    }
    .script-item header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
    }
    .script-item header .title {
      font-weight: 600;
      font-size: 15px;
    }
    .script-item header .badge {
      font-size: 12px;
      padding: 2px 6px;
      border-radius: 8px;
      background: #f3f3f3;
      border: 1px solid var(--border);
    }
    .script-desc { margin: 12px 0; color: var(--muted); }
    .script-meta { margin-bottom: 12px; font-size: 13px; color: var(--muted); }
    .script-meta code {
      display: inline-block;
      padding: 2px 4px;
      background: #f5f5f5;
      border-radius: 6px;
      border: 1px solid #e1e1e1;
      font-size: 12px;
    }
    form.script-runner {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 8px;
    }
    form.script-runner input[type="text"],
    form.script-runner input[type="password"] {
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font: inherit;
    }
    form.script-runner button {
      align-self: flex-start;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid var(--accent);
      background: var(--accent);
      color: #fff;
      cursor: pointer;
      font-weight: 500;
      transition: background 0.15s;
    }
    form.script-runner button[disabled] {
      opacity: 0.5;
      cursor: wait;
    }
    .script-output {
      border-radius: 8px;
      border: 1px solid #e1e1e1;
      background: #f7f7f7;
      padding: 8px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 12px;
      white-space: pre-wrap;
      min-height: 24px;
    }
    .file-list{list-style:none;padding:0;margin:0}
    .file-list li{display:flex;align-items:center;gap:8px;padding:4px 0;border-bottom:1px solid var(--border)}
    .file-list code{flex:1}
    .file-meta{font-size:12px;color:var(--muted)}
    .custo-tree, .custo-tree ul{list-style:none;margin:0;padding:0}
    .custo-tree ul{padding-left:16px;margin-left:6px;border-left:1px dashed var(--border)}
    .custo-tree-dir > details > summary{cursor:pointer;font-weight:600;padding:3px 0;list-style:none}
    .custo-tree-dir > details > summary::-webkit-details-marker{display:none}
    .custo-tree-dir > details > summary::before{content:"📂 "}
    .custo-tree-file{display:flex;align-items:center;gap:8px;padding:3px 0 3px 20px;border-bottom:1px solid var(--border)}
    .custo-tree-file::before{content:"📄 "}
    .custo-tree-file code{flex:1}
    .inline-form{display:inline-flex;align-items:center;gap:6px;margin-left:6px}
    .inline-form input[type="text"]{padding:4px 6px;font-size:12px;border-radius:6px;border:1px solid var(--border);width:140px}
    .inline-form input[type="file"]{display:none}
    .upload-status{font-size:12px;color:var(--muted);margin-left:6px;min-height:16px}
    .templates, .notes {
      margin: 8px 0;
      padding-left: 16px;
      color: var(--muted);
    }
    .templates li,
    .notes li {
      margin-bottom: 4px;
    }
    .guide-callout {
      border-left: 4px solid var(--accent);
      margin-bottom: 20px;
    }
    .guide-callout h3 {
      margin-top: 0;
    }
    .guide-callout ol {
      margin: 8px 0 0;
      padding-left: 20px;
    }
    .guide-callout li {
      margin-bottom: 6px;
    }
    .guide-callout code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      background: #f3f3f6;
      padding: 1px 5px;
      border-radius: 4px;
    }
    .script-form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 8px 12px;
      margin-top: 4px;
    }
    .script-form-grid label {
      display: flex;
      flex-direction: column;
      font-size: 13px;
      color: var(--muted);
    }
    .script-form-grid label span {
      font-weight: 500;
      color: inherit;
    }
    .script-form-grid label input[type="text"] {
      margin-top: 4px;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font: inherit;
      color: var(--fg);
    }
    .script-form-grid label select {
      margin-top: 4px;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font: inherit;
      color: var(--fg);
      background: #fff;
    }
    .script-form-grid label select[multiple] {
      min-height: 96px;
    }
    .field-hint {
      display: block;
      margin-top: 4px;
      font-size: 11px;
      font-weight: 400;
      color: var(--muted);
    }
    .script-form-grid label.checkbox {
      flex-direction: row;
      align-items: center;
      gap: 8px;
      margin-top: 8px;
    }
    .script-form-grid label.checkbox input[type="checkbox"] {
      margin: 0;
    }
    .script-form-grid label.checkbox span {
      font-weight: 500;
    }
    .topbar-shell {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }
    .topbar {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 12px;
      padding: 12px 0;
    }
    .topbar-nav {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .topbar-title {
      font-size: 18px;
      font-weight: 700;
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .brand-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      font-size: 14px;
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #fff;
    }
    .brand-logo {
      width: 24px;
      height: 24px;
      border-radius: 8px;
      background: var(--accent);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 14px;
      letter-spacing: 0.5px;
    }
    .dropdown {
      position: relative;
    }
    .dropdown summary {
      list-style: none;
      cursor: pointer;
      padding: 8px 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #fff;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      user-select: none;
    }
    .dropdown summary::-webkit-details-marker { display: none; }
    .dropdown[open] summary {
      border-color: var(--accent);
      box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }
    .dropdown-menu {
      position: absolute;
      min-width: 220px;
      margin-top: 6px;
      padding: 8px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: #fff;
      box-shadow: 0 12px 30px rgba(0,0,0,0.08);
      display: grid;
      gap: 6px;
      z-index: 30;
    }
    .dropdown a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 10px;
      border-radius: 8px;
      text-decoration: none;
      color: inherit;
      border: 1px solid transparent;
      transition: background 0.12s, border-color 0.12s;
      font-size: 13px;
      font-weight: 600;
    }
    .dropdown a:hover {
      background: #f5f7ff;
      border-color: var(--border);
    }
    .operations-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .io-layout {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      align-items: stretch;
      min-height: calc(100vh - 160px);
    }
    .io-layout-2col {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    @media (max-width: 1100px) {
      .io-layout {
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      }
    }
    .io-card {
      display: flex;
      flex-direction: column;
      height: 100%;
    }
    .monitoring-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .monitoring-panel {
      display: none;
    }
    .monitoring-panel.active {
      display: block;
    }
    .metrics-list {
      list-style: none;
      padding: 0;
      margin: 8px 0 0;
    }
    .metrics-list li {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 4px;
      font-size: 13px;
    }
    .inline-filter-form {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 16px;
      align-items: flex-end;
    }
    .inline-filter-form label {
      display: flex;
      flex-direction: column;
      font-size: 13px;
      color: var(--muted);
    }
    .inline-filter-form select {
      margin-top: 4px;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font: inherit;
    }
    .inputs-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .inputs-header h2 {
      margin: 0;
    }
    .inputs-header form {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
    }
    .btn-upload {
      padding: 6px 12px;
      border-radius: 8px;
      border: none;
      background: var(--accent);
      color: #0b1020;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-upload:disabled {
      opacity: 0.5;
      cursor: default;
    }
    .scroll-limited {
      max-height: calc(5 * 48px);
      overflow-y: auto;
    }
    .io-card .scroll-limited {
      max-height: none;
      flex: 1;
      min-height: 320px;
    }
    .guide-layout {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 20px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .guide-layout {
        grid-template-columns: 1fr;
      }
    }
    .guide-list {
      list-style: none;
      margin: 8px 0 0;
      padding: 0;
    }
    .guide-list li + li {
      margin-top: 2px;
    }
    .guide-list a {
      display: block;
      padding: 6px 8px;
      border-radius: 8px;
      color: inherit;
    }
    .guide-list a:hover {
      background: #f3f6ff;
      text-decoration: none;
    }
    .guide-list a.active {
      background: var(--accent);
      color: #0b1020;
      font-weight: 600;
    }
    .guide-content h1, .guide-content h2, .guide-content h3 {
      margin-top: 1.4em;
    }
    .guide-content h1:first-child, .guide-content h2:first-child, .guide-content h3:first-child {
      margin-top: 0;
    }
    .guide-content code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      background: #f3f3f6;
      padding: 1px 5px;
      border-radius: 4px;
    }
    .guide-content pre {
      background: #f3f3f6;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px;
      overflow-x: auto;
    }
    .guide-content pre code {
      background: none;
      padding: 0;
    }
    .guide-content table {
      margin: 12px 0;
    }
    .guide-content blockquote {
      margin: 12px 0;
      padding: 4px 12px;
      border-left: 3px solid var(--border);
      color: var(--muted);
    }
    .io-subsection {
      margin-top: 12px;
    }
    .io-subsection h3 {
      margin-top: 0;
      margin-bottom: 6px;
    }
    .muted {
      color: var(--muted);
    }
    .io-subsection .muted {
      margin-bottom: 8px;
      display: block;
    }
    .scroll-table {
      max-height: 240px;
      overflow: auto;
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .scroll-table table {
      margin: 0;
    }
    .empty-state {
      color: var(--muted);
      font-size: 13px;
      padding: 8px 0;
    }
    .topbar-shell {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }
    .topbar {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 12px;
      padding: 12px 0;
    }
    .topbar-nav {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .topbar-title {
      font-size: 18px;
      font-weight: 700;
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .brand-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      font-size: 14px;
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #fff;
    }
    .brand-logo {
      width: 24px;
      height: 24px;
      border-radius: 8px;
      background: var(--accent);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 14px;
      letter-spacing: 0.5px;
    }
    .dropdown {
      position: relative;
    }
    .dropdown summary {
      list-style: none;
      cursor: pointer;
      padding: 8px 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #fff;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      user-select: none;
    }
    .dropdown summary::-webkit-details-marker { display: none; }
    .dropdown[open] summary {
      border-color: var(--accent);
      box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }
    .dropdown-menu {
      position: absolute;
      min-width: 220px;
      margin-top: 6px;
      padding: 8px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: #fff;
      box-shadow: 0 12px 30px rgba(0,0,0,0.08);
      display: grid;
      gap: 6px;
      z-index: 30;
    }
    .dropdown a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 10px;
      border-radius: 8px;
      text-decoration: none;
      color: inherit;
      border: 1px solid transparent;
      transition: background 0.12s, border-color 0.12s;
      font-size: 13px;
      font-weight: 600;
    }
    .dropdown a:hover {
      background: #f5f7ff;
      border-color: var(--border);
    }
    .plan-view {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .plan-filter-form {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: flex-end;
    }
    .plan-filter-form label {
      display: flex;
      flex-direction: column;
      font-size: 13px;
      color: var(--muted);
      min-width: 220px;
    }
    .plan-filter-form select {
      margin-top: 4px;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font: inherit;
      background: #fff;
      color: var(--fg);
    }
    .plan-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 16px;
      align-items: start;
    }
    .plan-canvas {
      padding: 10px;
    }
    .plan-object {
      width: 100%;
      min-height: 72vh;
      max-height: 82vh;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fff;
    }
    .plan-side {
      display: flex;
      flex-direction: column;
      gap: 16px;
      position: sticky;
      top: 88px;
    }
    .plan-seat-panel {
      display: none;
    }
    .plan-seat-panel.active {
      display: block;
    }
    .plan-seat-panel dl {
      margin: 0;
      display: grid;
      gap: 10px;
    }
    .plan-seat-panel dt {
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .plan-seat-panel dd {
      margin: 2px 0 0;
      font-weight: 600;
      overflow-wrap: anywhere;
    }
    .plan-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 8px;
    }
    .plan-legend .pill {
      border: 1px solid var(--border);
      background: #fff;
    }
    @media (max-width: 1180px) {
      .plan-layout {
        grid-template-columns: minmax(0, 1fr);
      }
      .plan-side {
        position: static;
      }
      .plan-object {
        min-height: 62vh;
      }
    }
    .records-view {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .records-toolbar {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      align-items: end;
    }
    .records-toolbar label {
      display: flex;
      flex-direction: column;
      font-size: 13px;
      color: var(--muted);
    }
    .records-toolbar select,
    .records-toolbar input[type="search"] {
      margin-top: 4px;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font: inherit;
      color: var(--fg);
      background: #fff;
    }
    .records-table-wrap {
      width: 100%;
      overflow: auto;
      border: 1px solid var(--border);
      border-radius: 10px;
      max-height: calc(100vh - 250px);
    }
    .records-table {
      width: 100%;
      min-width: 980px;
      border-collapse: collapse;
    }
    .records-table thead th {
      position: sticky;
      top: 0;
      background: #f7f9ff;
      z-index: 2;
    }
    @media (max-width: 980px) {
      .records-toolbar {
        grid-template-columns: minmax(0, 1fr);
      }
      .records-table-wrap {
        max-height: none;
      }
    }
  </style>
</head>
<body>
  <% const tokenQueryString = tokenQuery ? ('?' + tokenQuery) : ''; %>
  <% const baseOperate = urlFor('/admin/operate') + tokenQueryString; %>
  <% const baseIo = urlFor('/admin/operate/io') + tokenQueryString; %>
  <% const baseTemplates = urlFor('/admin/doc') + tokenQueryString; %>
  <% const baseMonitor = urlFor('/admin/monitor') + tokenQueryString; %>
  <% const basePlan = urlFor('/admin/plan') + tokenQueryString; %>
  <% const baseOrders = urlFor('/admin/orders') + tokenQueryString; %>
  <% const baseTickets = urlFor('/admin/tickets') + tokenQueryString; %>
  <%
    // Two-level nav: "BTS Admin" picks a category; a second dropdown (only
    // rendered when the active category has chapters) picks a chapter within it.
    // Plan/Orders/Tickets are folded into Monitoring as chapters, since all of
    // Monitoring's tabs (like these three) are inspection views, not script runners.
    // "Data I/O" is not a category on its own: data/inputs + data/outputs are an
    // Operation concern (feeding/collecting script runs), so they're Operate's
    // first chapter; the read-only customization/template/asset listings are a
    // Monitoring concern (inspecting current system state), so they're Monitoring's
    // first chapter ("Custo files").
    const activeCategoryId = ['io'].includes(viewMode)
      ? 'operate'
      : ['plan', 'orders', 'tickets'].includes(viewMode)
        ? 'monitor'
        : viewMode;
    const navCategories = [
      { id: 'operate', label: 'Operation', href: baseOperate },
      { id: 'monitor', label: 'Monitoring', href: baseMonitor },
      { id: 'templates', label: 'Documentation', href: baseTemplates }
    ];
    const monitorHref = (tab) => `${baseMonitor}${baseMonitor.includes('?') ? '&' : '?'}monitorTab=${tab}`;
    const docHref = (tab) => `${baseTemplates}${baseTemplates.includes('?') ? '&' : '?'}docTab=${tab}`;
    // "Overview" lands each category on its intro/index page (see the
    // "showXxxIntro" blocks below) instead of jumping straight into the
    // first chapter — that's what the "BTS Admin" pulldown links to.
    const showOperateIntro = viewMode === 'operate' && !activeGroupId;
    const showDocIntro = viewMode === 'templates' && !docTab;
    const showMonitorIntro = viewMode === 'monitor' && !monitorTab;
    const categoryChapters = {
      operate: [
        { id: 'overview', label: 'Overview', href: baseOperate, active: showOperateIntro },
        { id: 'io', label: 'Data I/O', href: baseIo, active: viewMode === 'io' },
        ...(scriptGroups || []).map((g) => ({
          id: g.id,
          label: g.label || g.id,
          href: `${baseOperate}${baseOperate.includes('?') ? '&' : '?'}group=${encodeURIComponent(g.id)}`,
          active: g.id === activeGroupId
        }))
      ],
      templates: [
        { id: 'overview', label: 'Overview', href: baseTemplates, active: showDocIntro },
        { id: 'guides', label: 'User guides', description: 'Step-by-step operator walkthroughs.', href: docHref('guides'), active: viewMode === 'templates' && docTab === 'guides' },
        { id: 'references', label: 'Data references', description: 'Everything under data_references: blank templates to copy (CSV, .env, customization JSON) plus example email/ticket templates and assets.', href: docHref('references'), active: viewMode === 'templates' && docTab === 'references' },
        { id: 'examples', label: 'Data examples', description: 'Complete starter kits under data_examples — venue map, tariffs, and branding bundled per scenario.', href: docHref('examples'), active: viewMode === 'templates' && docTab === 'examples' }
      ],
      monitor: [
        { id: 'overview', label: 'Overview', href: baseMonitor, active: showMonitorIntro },
        { id: 'custo', label: 'Custo files', description: 'Parcourt data/customization et data/templates sous forme d’arborescence.', href: monitorHref('custo'), active: viewMode === 'monitor' && monitorTab === 'custo' },
        { id: 'system', label: 'Système', description: 'État serveur, MongoDB, connexions actives.', href: monitorHref('system'), active: viewMode === 'monitor' && monitorTab === 'system' },
        { id: 'venue', label: 'Lieux', description: 'Lieux enregistrés, zones, plans associés.', href: monitorHref('venue'), active: viewMode === 'monitor' && monitorTab === 'venue' },
        { id: 'tariffs', label: 'Tarifs', description: 'Catalogues et grilles tarifaires par lieu/saison.', href: monitorHref('tariffs'), active: viewMode === 'monitor' && monitorTab === 'tariffs' },
        { id: 'seasons', label: 'Saisons', description: 'Saisons enregistrées et leur statut.', href: monitorHref('seasons'), active: viewMode === 'monitor' && monitorTab === 'seasons' },
        { id: 'events', label: 'Événements', description: 'Événements enregistrés et leur statut de vente.', href: monitorHref('events'), active: viewMode === 'monitor' && monitorTab === 'events' },
        { id: 'partners', label: 'Partenaires', description: 'Partenaires configurés, mode de paiement, tarifs publics.', href: monitorHref('partners'), active: viewMode === 'monitor' && monitorTab === 'partners' },
        { id: 'plan', label: 'Plan', description: 'Visualisation du plan de salle et de l’occupation des sièges.', href: basePlan, active: viewMode === 'plan' },
        { id: 'orders', label: 'Orders', description: 'Recherche et détail des commandes.', href: baseOrders, active: viewMode === 'orders' },
        { id: 'tickets', label: 'Tickets', description: 'Recherche et détail des billets émis.', href: baseTickets, active: viewMode === 'tickets' }
      ]
    };
    const activeCategory = navCategories.find((c) => c.id === activeCategoryId);
    const activeChapters = categoryChapters[activeCategoryId] || [];
    const categoryTitles = {
      operate: 'Operation management',
      templates: 'Documentation',
      monitor: 'Monitoring'
    };
    const activeChapter = activeChapters.find((ch) => ch.active);
    const pageTitle = 'BTS > Administration'
      + (activeCategory ? ` / ${categoryTitles[activeCategory.id] || activeCategory.label}` : '')
      + (activeChapter ? ` / ${activeChapter.label}` : '');
  %>
  <div class="topbar-shell">
    <div class="topbar">
      <div class="topbar-nav">
        <details class="dropdown">
          <summary class="brand-chip">
            <span class="brand-logo">B</span>
            <span>BTS Admin</span>
          </summary>
          <div class="dropdown-menu">
            <% navCategories.forEach((cat) => { %>
              <a href="<%= cat.href %>" class="<%= cat.id === activeCategoryId ? 'active' : '' %>"><%= cat.label %></a>
            <% }); %>
          </div>
        </details>

        <% if (activeChapters.length) { %>
          <details class="dropdown">
            <summary class="script-tab active"><%= activeCategory ? activeCategory.label : '' %></summary>
            <div class="dropdown-menu">
              <% activeChapters.forEach((ch) => { %>
                <a href="<%= ch.href %>" class="<%= ch.active ? 'active' : '' %>"><%= ch.label %></a>
              <% }); %>
            </div>
          </details>
        <% } %>
      </div>

      <div class="topbar-title"><%= pageTitle %></div>
    </div>
  </div>

  <% if (viewMode === 'io') { %>
    <div class="operations-grid io-layout io-layout-2col">
      <section class="card io-card">
        <div class="inputs-header">
          <h2>Entrées disponibles (data/inputs)</h2>
          <% const uploadAction = urlFor('/admin/uploads') + (tokenSuffix || ''); %>
          <form class="inline-form" data-upload-form data-upload-dir="" action="<%= uploadAction %>" method="post">
            <input type="file" name="file" data-upload-input hidden />
            <input type="hidden" name="targetName" data-upload-target />
            <button type="button" class="btn-upload" data-upload-trigger>Uploader</button>
            <span class="upload-status" data-upload-status></span>
          </form>
        </div>
        <% if (!inputsList || !inputsList.length) { %>
          <div class="muted">Ajoutez vos CSV/SVG grâce au bouton ci-dessus.</div>
        <% } else { %>
          <% const deleteInputsUrl = urlFor('/admin/inputs/delete') + (tokenSuffix || ''); %>
          <ul class="file-list scroll-limited">
            <% for (const file of inputsList || []) {
                 const dlUrl = urlFor('/admin/inputs/download') + '?file=' + encodeURIComponent(file.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
            %>
              <li>
                <code><%= file.name %></code>
                <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                <a class="btn btn-small" href="<%= dlUrl %>">Télécharger</a>
                <button
                  type="button"
                  class="btn btn-small btn-danger"
                  data-delete-button
                  data-delete-url="<%= deleteInputsUrl %>"
                  data-file="<%= file.rel %>"
                  data-label="Supprimer">Supprimer</button>
              </li>
            <% } %>
          </ul>
        <% } %>
      </section>

      <section class="card io-card">
        <h2>Fichiers générés (data/outputs)</h2>
        <% if (!outputsList || !outputsList.length) { %>
          <div class="muted">Aucun export enregistré pour le moment.</div>
        <% } else { %>
          <% const deleteOutputsUrl = urlFor('/admin/outputs/delete') + (tokenSuffix || ''); %>
          <ul class="file-list scroll-limited">
            <% for (const file of outputsList || []) {
                 const dlUrl = urlFor('/admin/outputs/download') + '?file=' + encodeURIComponent(file.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
            %>
              <li>
                <code><%= file.name %></code>
                <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                <a class="btn btn-small" href="<%= dlUrl %>">Télécharger</a>
                <button
                  type="button"
                  class="btn btn-small btn-danger"
                  data-delete-button
                  data-delete-url="<%= deleteOutputsUrl %>"
                  data-file="<%= file.rel %>"
                  data-label="Supprimer">Supprimer</button>
              </li>
            <% } %>
          </ul>
        <% } %>
      </section>
    </div>
  <% } %>

  <% if (viewMode === 'home') { %>
    <section class="card intro-card">
      <h2>BTS — Administration</h2>
      <p class="muted">Choose a section below.</p>
      <ul class="intro-list">
        <li>
          <a href="<%= baseOperate %>">Operation</a>
          <span class="intro-item-desc">Run setup, import, and export scripts — organized by chapter.</span>
        </li>
        <li>
          <a href="<%= baseMonitor %>">Monitoring</a>
          <span class="intro-item-desc">Inspect current system state: files, orders, tickets, seating plan.</span>
        </li>
        <li>
          <a href="<%= baseTemplates %>">Documentation</a>
          <span class="intro-item-desc">Guides, reference templates, and example files.</span>
        </li>
      </ul>
    </section>
  <% } %>

  <% if (showDocIntro) { %>
    <section class="card intro-card">
      <h2>Documentation — Overview</h2>
      <p class="muted">Pick a chapter below, or use the dropdown above.</p>
      <ul class="intro-list">
        <% for (const ch of categoryChapters.templates) { if (ch.id === 'overview') continue; %>
          <li>
            <a href="<%= ch.href %>"><%= ch.label %></a>
            <% if (ch.description) { %><span class="intro-item-desc"><%= ch.description %></span><% } %>
          </li>
        <% } %>
      </ul>
    </section>
  <% } %>

  <% if (viewMode === 'templates' && docTab) { %>
    <div class="monitoring-panel <%= docTab === 'guides' ? 'active' : '' %>" data-doc-panel="guides">
      <% if (!guidesList || !guidesList.length) { %>
        <div class="operations-grid io-layout">
          <section class="card io-card">
            <h2>User guides</h2>
            <div class="muted">Aucun guide utilisateur pour le moment.</div>
          </section>
        </div>
      <% } else { %>
        <div class="guide-layout">
          <section class="card">
            <h2>Guides</h2>
            <ul class="guide-list">
              <% guidesList.forEach((g) => {
                   const isActive = activeGuide && activeGuide.rel === g.rel;
                   const href = docHref('guides') + (docHref('guides').includes('?') ? '&' : '?') + 'guide=' + encodeURIComponent(g.rel);
              %>
                <li><a href="<%= href %>" class="<%= isActive ? 'active' : '' %>"><%= g.title %></a></li>
              <% }); %>
            </ul>
          </section>
          <section class="card guide-content">
            <% if (activeGuide) { %>
              <%- activeGuide.html %>
            <% } else { %>
              <div class="muted">Sélectionnez un guide dans la liste.</div>
            <% } %>
          </section>
        </div>
      <% } %>
    </div>

    <div class="monitoring-panel <%= docTab === 'references' ? 'active' : '' %>" data-doc-panel="references">
      <div class="operations-grid io-layout io-layout-2col">
        <section class="card io-card">
          <h2>.env & Customization</h2>
          <h3>.env (data_references/env)</h3>
          <% if (!templatesEnv || !templatesEnv.length) { %>
            <div class="muted">Aucun fichier détecté dans data_references/env.</div>
          <% } else { %>
            <ul class="file-list scroll-limited">
              <% for (const file of templatesEnv || []) {
                   const dlUrl = urlFor('/admin/templates/download') + '?path=' + encodeURIComponent('data_references/env/' + file.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
              %>
                <li>
                  <code><%= file.rel %></code>
                  <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                  <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                  <a class="btn btn-small" href="<%= dlUrl %>">Télécharger</a>
                </li>
              <% } %>
            </ul>
          <% } %>

          <h3>Customizations (data_references/customization)</h3>
          <% if (!customizationList || !customizationList.length) { %>
            <div class="muted">Aucune customization détectée.</div>
          <% } else { %>
            <ul class="file-list scroll-limited">
              <% for (const file of customizationList || []) {
                   const dlUrl = urlFor('/admin/templates/download') + '?path=' + encodeURIComponent('data_references/customization/' + file.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
              %>
                <li>
                  <code><%= file.rel %></code>
                  <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                  <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                  <a class="btn btn-small" href="<%= dlUrl %>">Télécharger</a>
                </li>
              <% } %>
            </ul>
          <% } %>
        </section>

        <section class="card io-card">
          <h2>Templates CSV & SVG</h2>
          <h3>CSV (data_references/csv)</h3>
          <% if (!templatesCsv || !templatesCsv.length) { %>
            <div class="muted">Aucun template détecté dans data_references/csv.</div>
          <% } else { %>
            <ul class="file-list scroll-limited">
              <% for (const file of templatesCsv || []) {
                   const dlUrl = urlFor('/admin/templates/download') + '?path=' + encodeURIComponent('data_references/csv/' + file.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
              %>
                <li>
                  <code><%= file.rel %></code>
                  <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                  <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                  <a class="btn btn-small" href="<%= dlUrl %>">Télécharger</a>
                </li>
              <% } %>
            </ul>
          <% } %>

          <h3>SVG (data_references/svg)</h3>
          <% if (!templatesSvg || !templatesSvg.length) { %>
            <div class="muted">Aucun template détecté dans data_references/svg.</div>
          <% } else { %>
            <ul class="file-list scroll-limited">
              <% for (const file of templatesSvg || []) {
                   const dlUrl = urlFor('/admin/templates/download') + '?path=' + encodeURIComponent('data_references/svg/' + file.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
              %>
                <li>
                  <code><%= file.rel %></code>
                  <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                  <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                  <a class="btn btn-small" href="<%= dlUrl %>">Télécharger</a>
                </li>
              <% } %>
            </ul>
          <% } %>
        </section>

        <section class="card io-card">
          <h2>Templates e-mail & Tickets</h2>
          <h3>E-mail (data_references/templates/email)</h3>
          <% if (!templatesEmail || !templatesEmail.length) { %>
            <div class="muted">Aucun template détecté dans data_references/templates/email.</div>
          <% } else { %>
            <ul class="file-list scroll-limited">
              <% for (const file of templatesEmail || []) {
                   const dlUrl = urlFor('/admin/templates/download') + '?path=' + encodeURIComponent('data_references/templates/email/' + file.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
              %>
                <li>
                  <code><%= file.rel %></code>
                  <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                  <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                  <a class="btn btn-small" href="<%= dlUrl %>">Télécharger</a>
                </li>
              <% } %>
            </ul>
          <% } %>

          <h3>Tickets (data_references/templates/tickets)</h3>
          <% if (!templatesTickets || !templatesTickets.length) { %>
            <div class="muted">Aucun template détecté dans data_references/templates/tickets.</div>
          <% } else { %>
            <ul class="file-list scroll-limited">
              <% for (const file of templatesTickets || []) {
                   const dlUrl = urlFor('/admin/templates/download') + '?path=' + encodeURIComponent('data_references/templates/tickets/' + file.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
              %>
                <li>
                  <code><%= file.rel %></code>
                  <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                  <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                  <a class="btn btn-small" href="<%= dlUrl %>">Télécharger</a>
                </li>
              <% } %>
            </ul>
          <% } %>
        </section>

        <section class="card io-card">
          <h2>Assets</h2>
          <h3>Assets (data_references/assets)</h3>
          <% if (!templatesAssets || !templatesAssets.length) { %>
            <div class="muted">Aucun asset détecté dans data_references/assets.</div>
          <% } else { %>
            <ul class="file-list scroll-limited">
              <% for (const file of templatesAssets || []) {
                   const dlUrl = urlFor('/admin/templates/download') + '?path=' + encodeURIComponent('data_references/assets/' + file.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
              %>
                <li>
                  <code><%= file.rel %></code>
                  <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                  <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                  <a class="btn btn-small" href="<%= dlUrl %>">Télécharger</a>
                </li>
              <% } %>
            </ul>
          <% } %>
        </section>
      </div>
    </div>

    <div class="monitoring-panel <%= docTab === 'examples' ? 'active' : '' %>" data-doc-panel="examples">
      <%
        // Local to this panel — mirrors the tree helper in the Custo files
        // monitor panel, kept self-contained rather than shared across
        // panels (EJS scriptlet functions defined inside one conditional
        // block shouldn't be relied on from another).
        function buildExampleFileTree(files) {
          const root = { type: 'dir', name: '', children: new Map(), fileCount: 0 };
          for (const file of (files || [])) {
            const parts = file.rel.split('/');
            let node = root;
            for (let i = 0; i < parts.length - 1; i++) {
              const part = parts[i];
              if (!node.children.has(part)) {
                node.children.set(part, { type: 'dir', name: part, children: new Map(), fileCount: 0 });
              }
              node = node.children.get(part);
              node.fileCount += 1;
            }
            node.children.set(parts[parts.length - 1], { type: 'file', name: parts[parts.length - 1], rel: file.rel, size: file.size, mtime: file.mtime });
          }
          const toArray = (node) => Array.from(node.children.values())
            .map(child => child.type === 'dir' ? Object.assign({}, child, { children: toArray(child) }) : child)
            .sort((a, b) => a.type !== b.type ? (a.type === 'dir' ? -1 : 1) : a.name.localeCompare(b.name));
          return toArray(root);
        }
        function renderExampleFileTree(nodes, downloadPrefix) {
      %>
        <ul class="custo-tree">
        <% nodes.forEach(function (node) { %>
          <% if (node.type === 'dir') { %>
            <li class="custo-tree-dir">
              <details open>
                <summary><%= node.name %>/ <span class="file-meta">(<%= node.fileCount %>)</span></summary>
                <% renderExampleFileTree(node.children, downloadPrefix); %>
              </details>
            </li>
          <% } else {
               const dlUrl = urlFor('/admin/templates/download') + '?path=' + encodeURIComponent(downloadPrefix + node.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
          %>
            <li class="custo-tree-file">
              <code><%= node.name %></code>
              <span class="file-meta"><%= (node.size/1024).toFixed(1) %> KB</span>
              <span class="file-meta"><%= new Date(node.mtime).toLocaleString() %></span>
              <a class="btn btn-small" href="<%= dlUrl %>" download="<%= node.name %>">Télécharger</a>
            </li>
          <% } %>
        <% }); %>
        </ul>
      <% } %>

      <section class="card io-card">
        <h2>Example bundles (data_examples)</h2>
        <p class="muted">Complete starter kits — venue map + zones/seats, tariff catalogs, and app branding — organized by scenario.</p>
        <% if (!dataExamplesList || !dataExamplesList.length) { %>
          <div class="muted">Aucun exemple détecté dans data_examples.</div>
        <% } else { %>
          <div class="scroll-limited">
            <% renderExampleFileTree(buildExampleFileTree(dataExamplesList), 'data_examples/'); %>
          </div>
        <% } %>
      </section>
    </div>
  <% } %>

  <% if (viewMode === 'plan' && planView) { %>
    <div class="plan-view">
      <section class="card">
        <h2>Plan administrateur</h2>
        <form method="get" action="<%= basePlan %>" class="plan-filter-form">
          <% if (token) { %><input type="hidden" name="token" value="<%= token %>"><% } %>
          <label>
            Saison
            <select name="season" data-auto-submit="change">
              <% if (planView.seasons && planView.seasons.length) { %>
                <% for (const s of planView.seasons) { %>
                  <option value="<%= s.code %>" <%= s.code === planView.selectedSeasonCode ? 'selected' : '' %>>
                    <%= s.code %><%= s.name ? ' — ' + s.name : '' %>
                  </option>
                <% } %>
              <% } else { %>
                <option value="">Aucune saison</option>
              <% } %>
            </select>
          </label>
          <label>
            Événement
            <select name="event" data-auto-submit="change">
              <% if (planView.events && planView.events.length) { %>
                <% for (const ev of planView.events) { const eventDate = ev.startsAt ? new Date(ev.startsAt).toLocaleString() : null; %>
                  <option value="<%= ev.slug %>" <%= ev.slug === planView.selectedEventSlug ? 'selected' : '' %>>
                    <%= ev.slug %><%= ev.name ? ' — ' + ev.name : '' %><%= eventDate ? ' (' + eventDate + ')' : '' %>
                  </option>
                <% } %>
              <% } else { %>
                <option value="">Aucun événement</option>
              <% } %>
            </select>
          </label>
          <noscript><button type="submit" class="btn btn-small">Actualiser</button></noscript>
        </form>
        <% if (planView.selectedEvent) { %>
          <div class="muted" style="margin-top:8px;">
            <strong><%= planView.selectedEvent.name || planView.selectedEvent.slug %></strong>
            · <%= planView.selectedEvent.startsAt ? new Date(planView.selectedEvent.startsAt).toLocaleString() : 'Date non définie' %>
            · Lieu: <%= planView.selectedEvent.venueSlug || planView.venueSlug || '—' %>
          </div>
        <% } %>
      </section>

      <div class="plan-layout">
        <section class="card plan-canvas">
          <% if (planView.planUrl) { %>
            <object
              class="plan-object"
              data-admin-plan-object
              id="adminPlanObject"
              type="image/svg+xml"
              data="<%= planView.planUrl %>">
            </object>
          <% } else { %>
            <div class="empty-state">Plan SVG introuvable pour la sélection courante.</div>
          <% } %>
        </section>

        <aside class="plan-side">
          <section class="card">
            <h3>Répartition des sièges</h3>
            <% const planSeatCounts = planView.seatCounts || {}; const planCountKeys = Object.keys(planSeatCounts); %>
            <% if (planCountKeys.length) { %>
              <ul class="metrics-list">
                <% for (const key of planCountKeys) { %>
                  <li><span><%= key %></span><span><%= planSeatCounts[key] %></span></li>
                <% } %>
              </ul>
            <% } else { %>
              <div class="empty-state">Aucun siège pour cette sélection.</div>
            <% } %>
            <div class="plan-legend">
              <span class="pill">Cliquez sur un siège pour voir son allocation.</span>
            </div>
          </section>

          <section class="card plan-seat-panel" data-plan-seat-panel>
            <h3 data-plan-seat-title>Allocation siège</h3>
            <dl>
              <div>
                <dt>Bénéficiaire</dt>
                <dd data-plan-seat-beneficiary>—</dd>
              </div>
              <div>
                <dt>Payer</dt>
                <dd data-plan-seat-payer>—</dd>
              </div>
              <div>
                <dt>Tarif</dt>
                <dd data-plan-seat-tariff>—</dd>
              </div>
              <div>
                <dt>Order id</dt>
                <dd data-plan-seat-order-id>—</dd>
              </div>
            </dl>
          </section>
        </aside>
      </div>
    </div>
  <% } %>

  <% if (viewMode === 'orders' && ordersView) { %>
    <div class="records-view">
      <section class="card">
        <h2>Orders administrateur</h2>
        <form method="get" action="<%= baseOrders %>" class="records-toolbar">
          <% if (token) { %><input type="hidden" name="token" value="<%= token %>"><% } %>
          <label>
            Saison
            <select name="season" data-auto-submit="change">
              <% if (ordersView.seasons && ordersView.seasons.length) { %>
                <% for (const s of ordersView.seasons) { %>
                  <option value="<%= s.code %>" <%= s.code === ordersView.selectedSeasonCode ? 'selected' : '' %>>
                    <%= s.code %><%= s.name ? ' — ' + s.name : '' %>
                  </option>
                <% } %>
              <% } else { %>
                <option value="">Aucune saison</option>
              <% } %>
            </select>
          </label>
          <label>
            Événement
            <select name="event" data-auto-submit="change">
              <% if (ordersView.events && ordersView.events.length) { %>
                <% for (const ev of ordersView.events) { const eventDate = ev.startsAt ? new Date(ev.startsAt).toLocaleString() : null; %>
                  <option value="<%= ev.slug %>" <%= ev.slug === ordersView.selectedEventSlug ? 'selected' : '' %>>
                    <%= ev.slug %><%= ev.name ? ' — ' + ev.name : '' %><%= eventDate ? ' (' + eventDate + ')' : '' %>
                  </option>
                <% } %>
              <% } else { %>
                <option value="">Aucun événement</option>
              <% } %>
            </select>
          </label>
          <label>
            Filtrer bénéficiaire / contact / email
            <input type="search" data-table-filter data-table-target="ordersRows" placeholder="Tapez un nom ou un email">
          </label>
          <noscript><button type="submit" class="btn btn-small">Actualiser</button></noscript>
        </form>
      </section>

      <section class="card">
        <% if (ordersView.rows && ordersView.rows.length) { %>
          <div class="records-table-wrap">
            <table class="records-table">
              <thead>
                <tr>
                  <th>Order id</th>
                  <th>Créé</th>
                  <th>Statut</th>
                  <th>Bénéficiaire(s)</th>
                  <th>Contact</th>
                  <th>Email</th>
                  <th>Tarif(s)</th>
                  <th>Lignes</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody id="ordersRows">
                <% for (const row of ordersView.rows) { %>
                  <tr data-search="<%= row.searchIndex || '' %>">
                    <td><code><%= row.id %></code></td>
                    <td><%= row.createdAt ? new Date(row.createdAt).toLocaleString() : '—' %></td>
                    <td><%= row.status || '—' %></td>
                    <td><%= row.beneficiaries && row.beneficiaries.length ? row.beneficiaries.join(', ') : '—' %></td>
                    <td><%= row.payerName || '—' %></td>
                    <td><%= row.payerEmail || '—' %></td>
                    <td><%= row.tariffs && row.tariffs.length ? row.tariffs.join(', ') : '—' %></td>
                    <td><%= row.lineCount || 0 %></td>
                    <td><%= ((row.totalCents || 0)/100).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' }) %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">Aucune commande pour cette sélection.</div>
        <% } %>
      </section>
    </div>
  <% } %>

  <% if (viewMode === 'tickets' && ticketsView) { %>
    <div class="records-view">
      <section class="card">
        <h2>Tickets administrateur</h2>
        <form method="get" action="<%= baseTickets %>" class="records-toolbar">
          <% if (token) { %><input type="hidden" name="token" value="<%= token %>"><% } %>
          <label>
            Saison
            <select name="season" data-auto-submit="change">
              <% if (ticketsView.seasons && ticketsView.seasons.length) { %>
                <% for (const s of ticketsView.seasons) { %>
                  <option value="<%= s.code %>" <%= s.code === ticketsView.selectedSeasonCode ? 'selected' : '' %>>
                    <%= s.code %><%= s.name ? ' — ' + s.name : '' %>
                  </option>
                <% } %>
              <% } else { %>
                <option value="">Aucune saison</option>
              <% } %>
            </select>
          </label>
          <label>
            Événement
            <select name="event" data-auto-submit="change">
              <% if (ticketsView.events && ticketsView.events.length) { %>
                <% for (const ev of ticketsView.events) { const eventDate = ev.startsAt ? new Date(ev.startsAt).toLocaleString() : null; %>
                  <option value="<%= ev.slug %>" <%= ev.slug === ticketsView.selectedEventSlug ? 'selected' : '' %>>
                    <%= ev.slug %><%= ev.name ? ' — ' + ev.name : '' %><%= eventDate ? ' (' + eventDate + ')' : '' %>
                  </option>
                <% } %>
              <% } else { %>
                <option value="">Aucun événement</option>
              <% } %>
            </select>
          </label>
          <label>
            Filtrer bénéficiaire / contact / email
            <input type="search" data-table-filter data-table-target="ticketsRows" placeholder="Tapez un nom ou un email">
          </label>
          <noscript><button type="submit" class="btn btn-small">Actualiser</button></noscript>
        </form>
      </section>

      <section class="card">
        <% if (ticketsView.rows && ticketsView.rows.length) { %>
          <div class="records-table-wrap">
            <table class="records-table">
              <thead>
                <tr>
                  <th>Ticket id</th>
                  <th>Siège</th>
                  <th>Tarif</th>
                  <th>Bénéficiaire</th>
                  <th>Email bénéficiaire</th>
                  <th>Contact</th>
                  <th>Email contact</th>
                  <th>Order id</th>
                  <th>Créé</th>
                  <th>Scan</th>
                </tr>
              </thead>
              <tbody id="ticketsRows">
                <% for (const row of ticketsView.rows) { %>
                  <tr data-search="<%= row.searchIndex || '' %>">
                    <td><code><%= row.id %></code></td>
                    <td><%= row.seatId || '—' %></td>
                    <td><%= row.tariffCode || '—' %></td>
                    <td><%= row.holderName || '—' %></td>
                    <td><%= row.holderEmail || '—' %></td>
                    <td><%= row.contactName || '—' %></td>
                    <td><%= row.contactEmail || '—' %></td>
                    <td><%= row.orderId && row.orderId !== '—' ? row.orderId : '—' %></td>
                    <td><%= row.createdAt ? new Date(row.createdAt).toLocaleString() : '—' %></td>
                    <td>
                      <%= row.scannedAt ? ('Scanné le ' + new Date(row.scannedAt).toLocaleString()) : 'Non scanné' %>
                      <% if ((row.scanCount || 0) > 0) { %>
                        (<%= row.scanCount %>)
                      <% } %>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">Aucun ticket pour cette sélection.</div>
        <% } %>
      </section>
    </div>
  <% } %>

  <% if (showOperateIntro) { %>
    <section class="card intro-card">
      <h2>Operation — Overview</h2>
      <p class="muted">Pick a script below, or use the chapter dropdown above to jump straight to one.</p>
      <ul class="intro-list">
        <li>
          <a href="<%= baseIo %>">Data I/O</a>
          <span class="intro-item-desc">Upload/download data files (inputs, outputs) — not a script.</span>
        </li>
      </ul>
      <% for (const group of scriptGroups || []) { %>
        <div class="intro-group">
          <h3><%= group.label %></h3>
          <% if (group.description) { %><p class="muted intro-group-desc"><%= group.description %></p><% } %>
          <ul class="intro-list">
            <% for (const script of group.scripts || []) {
                 const scriptHref = `${baseOperate}${baseOperate.includes('?') ? '&' : '?'}group=${encodeURIComponent(group.id)}#script-${encodeURIComponent(script.id)}`;
            %>
              <li>
                <a href="<%= scriptHref %>"><%= script.label %></a>
                <span class="intro-item-desc"><%= script.description %></span>
              </li>
            <% } %>
          </ul>
        </div>
      <% } %>
    </section>
  <% } %>

  <% if (viewMode === 'operate' && activeGroupId) { %>
    <section class="card scripts-card">
      <h2>Scripts opérationnels</h2>
      <p style="color: var(--muted); margin-bottom: 16px;">
        Les scripts sont organisés par thématique. Ajoutez des arguments optionnels dans le champ prévu puis exécutez. Les chemins de template sont indiqués pour faciliter la préparation des fichiers.
      </p>

      <% for (const group of scriptGroups || []) { %>
        <div class="script-group <%= group.id === activeGroupId ? 'active' : '' %>" data-script-group="<%= group.id %>">
          <% for (const script of group.scripts || []) {
               const isAutomation = !!(script.automation && script.automation.taskId);
               const runUrl = urlFor((isAutomation ? '/admin/automation/scripts/' : '/admin/scripts/') + script.id + (isAutomation ? '/jobs' : '/run')) + (tokenSuffix || '');
               const jobsUrl = isAutomation ? (urlFor('/admin/automation/scripts/' + script.id + '/jobs') + (tokenSuffix || '')) : '';
               const jobDetailBase = urlFor('/admin/automation/jobs/');
               const automationJobList = (automationJobs && automationJobs[script.id]) || [];
               const defaultDryRun = script.automation && script.automation.defaultDryRun ? 'true' : 'false';
          %>
            <article class="script-item <%= script.danger ? 'danger' : '' %>" id="script-<%= script.id %>">
              <header>
                <div class="title"><%= script.label %></div>
                <div class="badge">#<%= script.order != null ? script.order.toString().padStart(2,'0') : '—' %></div>
              </header>
              <div class="script-desc"><%= script.description %></div>
              <div class="script-meta">
                <div><strong>Commande</strong> : <code><%= script.command %></code></div>
                <% if (script.templates && script.templates.length) { %>
                  <div>Templates :</div>
                  <ul class="templates">
                    <% for (const t of script.templates) {
                         const templateDownloadUrl = urlFor('/admin/templates/download') + '?path=' + encodeURIComponent(t) + (token ? '&token=' + encodeURIComponent(token) : '');
                    %>
                      <li>
                        <code><%= t %></code>
                        <a class="btn btn-small" href="<%= templateDownloadUrl %>">Télécharger</a>
                      </li>
                    <% } %>
                  </ul>
                <% } %>
                <% if (script.notes && script.notes.length) { %>
                  <div>Notes :</div>
                  <ul class="notes">
                    <% for (const note of script.notes) { %>
                      <li><%= note %></li>
                    <% } %>
                  </ul>
                <% } %>
                <% if (script.danger) { %>
                  <div class="danger">Action dangereuse — confirmation obligatoire (<code><%= script.id %></code>).</div>
                <% } %>
              </div>

              <form
                class="script-runner"
                data-script-form
                data-script-id="<%= script.id %>"
                data-mode="<%= isAutomation ? 'automation' : 'cli' %>"
                data-action="<%= runUrl %>"
                <% if (isAutomation) { %>
                  data-jobs-url="<%= jobsUrl %>"
                  data-job-detail-base="<%= jobDetailBase %>"
                  data-token-suffix="<%= tokenSuffix || '' %>"
                  data-default-dry-run="<%= defaultDryRun %>"
                <% } %>>
                <% if (script.form && script.form.fields && script.form.fields.length) { %>
                  <% const opt = operateOptions || {}; const freeSeasonField = script.id === 'create-season'; const freeCatalogField = script.id === 'import-tariff-prices'; %>
                  <div class="script-form-grid">
                  <% for (const field of script.form.fields) { 
                         const inputRole = script.id + ':' + field.name;
                         const fieldType = field.type || 'text';
                         const hasInputFiles =
                           Array.isArray(opt.inputFiles)
                           && opt.inputFiles.length
                           && field.placeholder
                           && field.placeholder.startsWith('data/inputs');
                          const hasAssetFiles =
                            Array.isArray(opt.assetFiles)
                            && opt.assetFiles.length
                            && field.placeholder
                           && field.placeholder.startsWith('public/dynamic/assets');
                         const hasCustomizationFiles =
                           Array.isArray(opt.customizationFiles)
                           && opt.customizationFiles.length
                           && field.placeholder
                           && field.placeholder.startsWith('data/customization/');
                         const datalistId = hasInputFiles
                           ? `inputs-${inputRole.replace(/[^a-zA-Z0-9_-]/g, '')}`
                           : null;
                         const hasEventSelect = field.name === 'event' && Array.isArray(opt.events) && opt.events.length;
                         const hasSeasonSelect = !freeSeasonField && field.name === 'season' && Array.isArray(opt.seasons) && opt.seasons.length;
                         const hasVenueSelect = field.name === 'venue' && Array.isArray(opt.venues) && opt.venues.length;
                         const hasVenueViewSelect = field.name === 'venueView' && Array.isArray(opt.venueViews) && opt.venueViews.length;
                         const isPartnerField = (field.name === 'partner' || field.name === 'partnerSlug' || (field.name === 'slug' && group.id === '05-partner-management'));
                         const hasPartnerSelect = isPartnerField && Array.isArray(opt.partners) && opt.partners.length;
                          const hasCatalogSelect = !freeCatalogField && field.name === 'catalog' && Array.isArray(opt.tariffCatalogs) && opt.tariffCatalogs.length;
                          const hasGoogleLibrarySelect = field.name === 'library' && Array.isArray(opt.googleLibraries) && opt.googleLibraries.length;
                          const defaultValue = (field.placeholder && field.placeholder.startsWith('data/outputs/'))
                           ? field.placeholder
                           : '';
                    %>
                      <% if (fieldType === 'checkbox') {
                           const defaultChecked = field.default === true;
                      %>
                        <label class="checkbox">
                          <input type="checkbox" data-role="<%= inputRole %>" <%= defaultChecked ? 'checked' : '' %> />
                          <span>
                            <%= field.label %>
                            <% if (field.hint) { %><small class="field-hint"><%= field.hint %></small><% } %>
                          </span>
                        </label>
                      <% } else { %>
                        <label>
                          <span><%= field.label %></span>
                          <% if (hasVenueViewSelect) { %>
                            <select data-role="<%= inputRole %>" <%= field.required ? 'required' : '' %>>
                              <option value="">— Aucune vue spécifique —</option>
                              <% for (const view of opt.venueViews) { const lbl = view.label || (view.venueSlug ? `${view.venueSlug} — ${view.slug}` : (view.slug || '')); %>
                                <option value="<%= view.slug %>"><%= lbl %></option>
                              <% } %>
                            </select>
                          <% } else if (Array.isArray(field.options) && field.options.length) { %>
                            <select data-role="<%= inputRole %>" <%= field.required ? 'required' : '' %>>
                              <% if (!field.required) { %><option value="">—</option><% } %>
                              <% for (const optItem of field.options) { const val = optItem.value ?? ''; const lbl = optItem.label ?? val; %>
                                <option value="<%= val %>"><%= lbl %></option>
                              <% } %>
                            </select>
                          <% } else if (hasEventSelect) { %>
                            <select data-role="<%= inputRole %>" <%= field.required ? 'required' : '' %>>
                              <option value="">— Choisir un événement —</option>
                              <% for (const ev of opt.events) { const dateLabel = ev.startsAt ? new Date(ev.startsAt).toLocaleString() : null; %>
                                <option value="<%= ev.slug %>">
                                  <%= ev.slug %><%= ev.name ? ' — ' + ev.name : '' %><%= dateLabel ? ' · ' + dateLabel : '' %>
                                </option>
                              <% } %>
                            </select>
                          <% } else if (hasSeasonSelect) { %>
                            <select data-role="<%= inputRole %>" <%= field.required ? 'required' : '' %>>
                              <option value="">— Choisir une saison —</option>
                              <% for (const season of opt.seasons) { %>
                                <option value="<%= season.code %>">
                                  <%= season.code %><%= season.name ? ' — ' + season.name : '' %>
                                </option>
                              <% } %>
                            </select>
                          <% } else if (hasVenueSelect) { %>
                            <select data-role="<%= inputRole %>" <%= field.required ? 'required' : '' %>>
                              <option value="">— Choisir un lieu —</option>
                              <% for (const venue of opt.venues) { %>
                                <option value="<%= venue.slug %>">
                                  <%= venue.slug %><%= venue.name ? ' — ' + venue.name : '' %>
                                </option>
                              <% } %>
                            </select>
                          <% } else if (hasPartnerSelect) { %>
                            <select data-role="<%= inputRole %>" <%= field.required ? 'required' : '' %>>
                              <option value="">— Choisir un partenaire —</option>
                              <% for (const partner of opt.partners) { %>
                                <option value="<%= partner.slug %>">
                                  <%= partner.slug %><%= partner.name ? ' — ' + partner.name : '' %>
                                </option>
                              <% } %>
                            </select>
                          <% } else if (hasCatalogSelect) { %>
                            <select data-role="<%= inputRole %>" multiple data-join="," <%= field.required ? 'required' : '' %>>
                              <% for (const cat of opt.tariffCatalogs) { %>
                                <option value="<%= cat %>"><%= cat %></option>
                              <% } %>
                            </select>
                            <small class="field-hint">Sélection multiple permise (Cmd/Ctrl + clic).</small>
                          <% } else if (hasGoogleLibrarySelect) { %>
                            <select data-role="<%= inputRole %>" <%= field.required ? 'required' : '' %>>
                              <option value="">— Choisir une bibliothèque —</option>
                              <% for (const lib of opt.googleLibraries) { %>
                                <option value="<%= lib.scriptId %>:<%= lib.latestVersion %>">
                                  <%= lib.title || lib.scriptId %> — v<%= lib.latestVersion %><%= lib.googleUser ? ' · ' + lib.googleUser : '' %> (<%= lib.scriptId.slice(0, 10) %>…)
                                </option>
                              <% } %>
                            </select>
                          <% } else if (hasAssetFiles) { %>
                            <select data-role="<%= inputRole %>" <%= field.required ? 'required' : '' %>>
                              <option value="">— Fichier dans data/inputs —</option>
                              <% for (const file of (opt.assetFiles || [])) { const val = `data/inputs/${file}`; %>
                                <option value="<%= val %>"><%= val %></option>
                              <% } %>
                            </select>
                            <small class="field-hint">Choisissez un fichier présent dans data/inputs ou saisissez un chemin personnalisé.</small>
                          <% } else if (hasCustomizationFiles) { %>
                            <select data-role="<%= inputRole %>" <%= field.required ? 'required' : '' %>>
                              <option value="">— Fichier dans data/inputs —</option>
                              <% for (const file of (opt.customizationFiles || [])) { const val = `data/inputs/${file}`; %>
                                <option value="<%= val %>"><%= val %></option>
                              <% } %>
                            </select>
                            <small class="field-hint">Choisissez un fichier présent dans data/inputs ou saisissez un chemin personnalisé.</small>
                          <% } else if (hasInputFiles) { %>
                            <select data-role="<%= inputRole %>" <%= field.required ? 'required' : '' %>>
                              <option value="">— Fichier dans data/inputs —</option>
                              <% for (const file of (opt.inputFiles || [])) { const val = `data/inputs/${file}`; %>
                                <option value="<%= val %>"><%= val %></option>
                              <% } %>
                            </select>
                            <small class="field-hint">Choisissez un fichier existant ou saisissez un chemin personnalisé.</small>
                          <% } else { %>
                            <input
                              type="text"
                              data-role="<%= inputRole %>"
                              placeholder="<%= field.placeholder || '' %>"
                              value="<%= defaultValue %>"
                              <%= datalistId ? `list=\"${datalistId}\"` : '' %> />
                            <% if (datalistId) { %>
                              <datalist id="<%= datalistId %>">
                                <% for (const file of (opt.inputFiles || [])) { %>
                                  <option value="data/inputs/<%= file %>"></option>
                                <% } %>
                              </datalist>
                            <% } %>
                          <% } %>
                          <% if (field.hint) { %><small class="field-hint"><%= field.hint %></small><% } %>
                        </label>
                      <% } %>
                    <% } %>
                  </div>
                <% } %>

                <% if (!isAutomation || script.allowArgs) { %>
                  <label>
                    Arguments additionnels
                    <input type="text" name="argLine" placeholder="ex : --apply --dry-run --extra=value" />
                  </label>
                <% } %>
                <% if (script.danger) { %>
                <label>
                  Confirmation (<code><%= script.id %></code>)
                  <input type="text" name="confirm" placeholder="<%= script.id %>" />
                </label>
                <% } %>
                <button type="submit">Exécuter</button>
                <div class="script-output" data-output></div>
              </form>

            </article>
            <% if (group.guide && group.guide.afterScriptId === script.id && group.guide.steps && group.guide.steps.length) { %>
              <section class="card guide-callout">
                <h3><%= group.guide.title %></h3>
                <ol>
                  <% for (const step of group.guide.steps) { %>
                    <li><%- step %></li>
                  <% } %>
                </ol>
              </section>
            <% } %>
          <% } %>
