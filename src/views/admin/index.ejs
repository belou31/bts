  <% } %>

  <script>
    const SCRIPT_FORMS = <%- JSON.stringify(scriptForms || {}).replace(/</g, '\\u003c') %>;
    const AUTOMATION_JOBS_STATE = <%- JSON.stringify(automationJobs || {}).replace(/</g, '\\u003c') %>;
    const PLAN_VIEW_DATA = <%- JSON.stringify(planView || null).replace(/</g, '\\u003c') %>;
    const CURRENT_VIEW_MODE = <%- JSON.stringify(viewMode || '') %>;
    (() => {
      document.querySelectorAll('[data-auto-submit]').forEach(el => {
        el.addEventListener('change', () => {
          const form = el.closest('form');
          if (form) form.submit();
        });
      });

      document.querySelectorAll('[data-table-filter]').forEach((input) => {
        const targetId = input.getAttribute('data-table-target') || '';
        if (!targetId) return;
        const tbody = document.getElementById(targetId);
        if (!tbody) return;
        const rows = Array.from(tbody.querySelectorAll('tr'));
        if (!rows.length) return;
        const normalize = (value) => String(value || '').trim().toLowerCase();
        const applyFilter = () => {
          const needle = normalize(input.value || '');
          rows.forEach((row) => {
            if (!needle) {
              row.style.display = '';
              return;
            }
            const hay = normalize(row.getAttribute('data-search') || '');
            row.style.display = hay.includes(needle) ? '' : 'none';
          });
        };
        input.addEventListener('input', applyFilter);
      });

      const collectScriptArgs = (form, argLine) => {
        const scriptId = form.dataset.scriptId;
        if (!scriptId) return { args: [], values: {}, anyFieldValue: false };
        const schema = SCRIPT_FORMS?.[scriptId];
        if (!schema?.fields?.length) return { args: [], values: {}, anyFieldValue: false };

        const hasManualArgs = typeof argLine === 'string' && argLine.trim().length > 0;
        const values = {};
        let anyFieldValue = false;
        const missing = [];

        schema.fields.forEach(field => {
          const selector = `[data-role="${scriptId}:${field.name}"]`;
          const el = form.querySelector(selector);
          if (!el) return;
          const fieldType = field.type || 'text';
          let value;
          let hasValue = false;

          if (fieldType === 'checkbox') {
            value = !!el.checked;
            hasValue = value === true;
          } else if (el.multiple) {
            const selected = Array.from(el.selectedOptions || [])
              .map(opt => (opt.value || '').trim())
              .filter(Boolean);
            const joiner = el.dataset?.join ?? ',';
            value = selected.join(joiner || ',');
            hasValue = selected.length > 0;
          } else {
            value = (el.value || '').trim();
            hasValue = value !== '';
          }

          if (hasValue) anyFieldValue = true;
          if (field.required && !hasValue) missing.push(field.label || field.name);

          if (fieldType === 'checkbox') {
            values[field.name] = value;
          } else {
            values[field.name] = Array.isArray(value) ? value.join(',') : value;
          }
        });

        if (!anyFieldValue) {
          return { args: [], values, anyFieldValue: false, missing };
        }

        if (missing.length) {
          if (hasManualArgs) {
            return { args: [], values, anyFieldValue, missing };
          }
          return { error: `Champs requis : ${missing.join(', ')}`, values, anyFieldValue, missing };
        }

        const positional = [];
        const trailing = [];

        schema.fields.forEach((field, index) => {
          const rule = field.arg;
          if (!rule) return;
          const value = values[field.name];
          const fieldType = field.type || 'text';
          const hasValue = fieldType === 'checkbox' ? !!value : value !== undefined && value !== null && value !== '';

          switch (rule.type) {
            case 'positional': {
              if (!hasValue) {
                if (!rule.optional) return;
              } else {
                positional.push({ order: rule.index ?? index, value });
              }
              break;
            }
            case 'option': {
              if (!hasValue) return;
              let rendered = rule.template || '';
              if (rendered.includes('${value}')) {
                rendered = rendered.replace(/\$\{value\}/g, value);
              } else if (rendered) {
                rendered = `${rendered}${value}`;
              } else {
                rendered = `--${field.name}=${value}`;
              }
              trailing.push({ order: rule.order ?? index, value: rendered });
              break;
            }
            case 'flag': {
              if (!hasValue) return;
              trailing.push({ order: rule.order ?? index, value: rule.flag || `--${field.name}` });
              break;
            }
            default:
              break;
          }
        });

        positional.sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
        trailing.sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

        const args = [
          ...positional.map(item => item.value),
          ...trailing.map(item => item.value)
        ];

        return { args, values, anyFieldValue: true, missing: [] };
      };

      const escapeHtml = (value) => {
        if (value == null) return '';
        return String(value).replace(/[&<>"']/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        }[char] || char));
      };

      const escapeSelector = (value) => String(value).replace(/([!"#$%&'()*+,./:;<=>?@[\\\]^`{|}~])/g, '\\$1');

      const normalizePlanSeatStatus = (raw = '') => {
        const val = String(raw || '').trim().toLowerCase();
        if (!val) return 'available';
        if (val === 'booked' || val === 'sold') return 'booked';
        if (['busy', 'provisioned', 'blocked', 'held', 'hold'].includes(val)) return 'busy';
        return 'available';
      };

      const extractPlanSeatId = (node) => {
        if (!node || typeof node.getAttribute !== 'function') return '';
        const fromData = String(node.getAttribute('data-seat-id') || node.getAttribute('data-seat') || '').trim();
        if (fromData) return fromData;
        const fromId = String(node.id || '').trim();
        if (!fromId) return '';
        if (fromId.startsWith('seat_')) return fromId.slice(5).trim();
        return '';
      };

      const findPlanSeatElement = (svgDoc, seatId) => {
        if (!svgDoc || !seatId) return null;
        const escaped = escapeSelector(seatId);
        const selectors = [
          `[data-seat-id="${seatId}"]`,
          `[data-seat="${seatId}"]`,
          `#${escaped}`,
          `#seat_${escaped}`
        ];
        for (const selector of selectors) {
          const node = svgDoc.querySelector(selector);
          if (node) return node;
        }
        return null;
      };

      const initAdminPlanView = () => {
        if (CURRENT_VIEW_MODE !== 'plan') return;
        const planObject = document.querySelector('[data-admin-plan-object]');
        if (!planObject || !PLAN_VIEW_DATA) return;

        const seatPanel = document.querySelector('[data-plan-seat-panel]');
        const seatTitle = document.querySelector('[data-plan-seat-title]');
        const beneficiaryEl = document.querySelector('[data-plan-seat-beneficiary]');
        const payerEl = document.querySelector('[data-plan-seat-payer]');
        const tariffEl = document.querySelector('[data-plan-seat-tariff]');
        const orderIdEl = document.querySelector('[data-plan-seat-order-id]');

        const seatStatusById = new Map(
          (Array.isArray(PLAN_VIEW_DATA.seats) ? PLAN_VIEW_DATA.seats : [])
            .map((entry) => [String(entry?.seatId || '').trim(), normalizePlanSeatStatus(entry?.status)])
            .filter(([seatId]) => Boolean(seatId))
        );
        const seatDetailsById = (PLAN_VIEW_DATA && typeof PLAN_VIEW_DATA.seatDetailsById === 'object' && PLAN_VIEW_DATA.seatDetailsById)
          ? PLAN_VIEW_DATA.seatDetailsById
          : {};

        let selectedSeatId = '';
        let selectedNode = null;
        let planInitialized = false;

        const clearSelected = () => {
          if (selectedNode) selectedNode.classList.remove('seat-selected');
          selectedSeatId = '';
          selectedNode = null;
        };

        const hidePanel = () => {
          if (!seatPanel) return;
          seatPanel.classList.remove('active');
        };

        const showSeatPanel = (seatId) => {
          if (!seatPanel) return;
          const details = seatDetailsById[seatId] || {};
          if (seatTitle) seatTitle.textContent = `Allocation siège ${seatId}`;
          if (beneficiaryEl) beneficiaryEl.textContent = details.beneficiary || '—';
          if (payerEl) payerEl.textContent = details.payer || '—';
          if (tariffEl) tariffEl.textContent = details.tariff || '—';
          if (orderIdEl) orderIdEl.textContent = details.orderId || '—';
          seatPanel.classList.add('active');
        };

        const applySeatStatuses = (svgDoc) => {
          seatStatusById.forEach((status, seatId) => {
            const node = findPlanSeatElement(svgDoc, seatId);
            if (!node) return;
            node.classList.remove('seat-available', 'seat-booked', 'seat-busy');
            if (status === 'booked') node.classList.add('seat-booked');
            else if (status === 'busy') node.classList.add('seat-busy');
            else node.classList.add('seat-available');
          });
        };

        const enablePlanPanZoom = (svgDoc) => {
          const svg = svgDoc?.querySelector('svg');
          if (!svg) return () => false;

          let host = svg.querySelector('#zoomHost');
          if (!host) {
            host = svgDoc.createElementNS('http://www.w3.org/2000/svg', 'g');
            host.setAttribute('id', 'zoomHost');
            while (svg.firstChild) host.appendChild(svg.firstChild);
            svg.appendChild(host);
          }

          try {
            const style = svgDoc.createElementNS('http://www.w3.org/2000/svg', 'style');
            style.textContent = 'text, .zone-label, .seat-label, [data-label] { pointer-events: none; }';
            svg.insertBefore(style, svg.firstChild);
          } catch (_) {}

          let scale = 1;
          let tx = 0;
          let ty = 0;
          let dragging = false;
          let moved = false;
          let suppressNextClick = false;
          let last = { x: 0, y: 0 };

          const apply = () => host.setAttribute('transform', `translate(${tx},${ty}) scale(${scale})`);
          const svgPoint = (evt) => {
            const pt = svg.createSVGPoint();
            pt.x = evt.clientX;
            pt.y = evt.clientY;
            const ctm = svg.getScreenCTM();
            if (!ctm) return { x: pt.x, y: pt.y };
            return pt.matrixTransform(ctm.inverse());
          };

          svg.style.cursor = 'grab';

          svg.addEventListener('wheel', (evt) => {
            evt.preventDefault();
            const delta = -(evt.deltaY || evt.wheelDelta || 0);
            const factor = Math.exp(delta * 0.0015);
            const p = svgPoint(evt);
            const newScale = Math.min(10, Math.max(0.25, scale * factor));
            const k = newScale / scale;
            tx = p.x - (p.x - tx) * k;
            ty = p.y - (p.y - ty) * k;
            scale = newScale;
            apply();
          }, { passive: false });

          const onDown = (evt) => {
            dragging = true;
            moved = false;
            last = svgPoint(evt);
            svg.style.cursor = 'grabbing';
          };
          const onMove = (evt) => {
            if (!dragging) return;
            const p = svgPoint(evt);
            const dx = p.x - last.x;
            const dy = p.y - last.y;
            if (Math.abs(dx) > 0.2 || Math.abs(dy) > 0.2) moved = true;
            tx += dx;
            ty += dy;
            last = p;
            apply();
          };
          const onUp = () => {
            if (!dragging) return;
            if (moved) suppressNextClick = true;
            dragging = false;
            svg.style.cursor = 'grab';
          };

          svg.addEventListener('mousedown', onDown);
          svg.addEventListener('mousemove', onMove);
          svg.addEventListener('mouseup', onUp);
          svg.addEventListener('mouseleave', onUp);

          return () => {
            if (!suppressNextClick) return false;
            suppressNextClick = false;
            return true;
          };
        };

        const bindPlanClicks = (svgDoc, shouldIgnoreClick = () => false) => {
          const clickable = svgDoc.querySelectorAll('[data-seat-id],[data-seat],[id^="seat_"]');
          clickable.forEach((node) => { node.style.cursor = 'pointer'; });

          svgDoc.addEventListener('click', (event) => {
            if (shouldIgnoreClick()) return;
            const targetNode = event.target?.closest?.('[data-seat-id],[data-seat],[id^="seat_"]');
            if (!targetNode) return;
            const seatId = extractPlanSeatId(targetNode);
            if (!seatId) return;

            if (seatId === selectedSeatId) {
              clearSelected();
              hidePanel();
              return;
            }

            clearSelected();
            selectedSeatId = seatId;
            selectedNode = targetNode;
            selectedNode.classList.add('seat-selected');
            showSeatPanel(seatId);
          });
        };

        const onReady = () => {
          if (planInitialized) return;
          const svgDoc = planObject.contentDocument;
          if (!svgDoc) return;
          planInitialized = true;
          const shouldIgnoreClick = enablePlanPanZoom(svgDoc);
          applySeatStatuses(svgDoc);
          bindPlanClicks(svgDoc, shouldIgnoreClick);
        };

        if (planObject.contentDocument) onReady();
        planObject.addEventListener('load', onReady, { once: true });
      };

      initAdminPlanView();

      const isReturnUrl = (value) => {
        if (value == null) return false;
        const s = String(value);
        return s.startsWith('/') || s.startsWith('http://') || s.startsWith('https://');
      };

      const sanitizeParams = (input = {}) => {
        const out = {};
        Object.entries(input).forEach(([key, value]) => {
          if (value === '' || value === undefined || value === null) return;
          out[key] = value;
        });
        return out;
      };

      const renderAutomationJobs = (scriptId) => {
        const container = document.querySelector(`[data-automation-jobs="${scriptId}"]`);
        if (!container) return;
        const jobs = AUTOMATION_JOBS_STATE[scriptId] || [];
        const table = container.querySelector('table[data-jobs-table]');
        const tbody = table ? table.querySelector('tbody') : null;
        const empty = container.querySelector('.automation-jobs-empty');
        if (!jobs.length) {
          if (tbody) tbody.innerHTML = '';
          if (table) table.style.display = 'none';
          if (empty) empty.style.display = 'block';
          return;
        }
        if (table) table.style.display = '';
        if (empty) empty.style.display = 'none';
        if (!tbody) return;
        tbody.innerHTML = jobs.map(job => {
          const summary = job?.result?.summary || job?.error?.message || '';
          const createdLabel = job?.createdAt ? new Date(job.createdAt).toLocaleString() : '—';
          const status = job?.status || 'unknown';
          const modeLabel = job?.dryRun ? 'dry-run' : 'envoi';
          return `<tr data-job-id="${escapeHtml(job.id)}"><td class="mono">${escapeHtml((job.id || '').slice(-6))}</td><td class="automation-job-status">${escapeHtml(status)}</td><td>${escapeHtml(modeLabel)}</td><td>${escapeHtml(summary || '—')}</td><td>${escapeHtml(createdLabel)}</td></tr>`;
        }).join('');
      };

      const refreshAutomationJobs = async (scriptId, { highlightJobId } = {}) => {
        const container = document.querySelector(`[data-automation-jobs="${scriptId}"]`);
        if (!container) return;
        const jobsUrl = container.dataset.jobsUrl || '';
        if (!jobsUrl) return;
        try {
          const response = await fetch(jobsUrl);
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          AUTOMATION_JOBS_STATE[scriptId] = Array.isArray(data.jobs) ? data.jobs : [];
          renderAutomationJobs(scriptId);
          if (highlightJobId) {
            const row = container.querySelector(`tr[data-job-id="${escapeSelector(highlightJobId)}"]`);
            if (row) {
              row.classList.add('highlight');
              setTimeout(() => row.classList.remove('highlight'), 1800);
            }
          }
        } catch (error) {
          console.error('⚠️ Impossible de rafraîchir les jobs automation', error);
        }
      };

      const setupCliForm = (form) => {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const output = form.querySelector('[data-output]');
          const button = form.querySelector('button[type="submit"]');
          const argLine = form.querySelector('input[name="argLine"]')?.value || '';
          const confirm = form.querySelector('input[name="confirm"]')?.value || '';
          const collected = collectScriptArgs(form, argLine);
          if (collected.error) {
            output.textContent = `✖ ${collected.error}`;
            return;
          }
          const presetArgs = Array.isArray(collected.args) ? collected.args : [];
          output.textContent = '⏳ Exécution en cours…';
          button.disabled = true;
          try {
            const response = await fetch(form.dataset.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                argLine,
                confirm,
                ...(presetArgs.length ? { args: presetArgs } : {})
              })
            });
            let data = {};
            try { data = await response.json(); } catch (_) {}
            if (!response.ok) {
              output.textContent = `✖ ${data.error || response.statusText}`;
            } else {
              let text = `✔ exit ${data.exitCode}\n`;
              if (data.stdout) text += data.stdout.trim() + '\n';
              if (data.stderr) text += '\n[stderr]\n' + data.stderr.trim();
              output.textContent = text.trim();
              if (data.returnUrl && (data.ok !== false) && isReturnUrl(data.returnUrl)) {
                const linkWrap = document.createElement('div');
                linkWrap.style.marginTop = '6px';
                const link = document.createElement('a');
                link.href = data.returnUrl;
                link.textContent = 'Télécharger le PDF';
                link.target = '_blank';
                link.rel = 'noreferrer';
                linkWrap.appendChild(link);
                output.appendChild(linkWrap);
              }
            }
          } catch (err) {
            output.textContent = `✖ ${err && err.message ? err.message : err}`;
          } finally {
            button.disabled = false;
          }
        });
      };

      const setupAutomationForm = (form) => {
        const scriptId = form.dataset.scriptId;
        const defaultDryRun = form.dataset.defaultDryRun === 'true';
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const output = form.querySelector('[data-output]');
          const button = form.querySelector('button[type="submit"]');
          const confirm = form.querySelector('input[name="confirm"]')?.value || '';
          const collected = collectScriptArgs(form, '');
          if (collected.error) {
            output.textContent = `✖ ${collected.error}`;
            return;
          }
          const paramsRaw = { ...collected.values };
          let dryRun = defaultDryRun;
          if (Object.prototype.hasOwnProperty.call(paramsRaw, 'dryRun')) {
            dryRun = Boolean(paramsRaw.dryRun);
            delete paramsRaw.dryRun;
          }
          if (Object.prototype.hasOwnProperty.call(paramsRaw, 'dry')) {
            dryRun = Boolean(paramsRaw.dry);
            delete paramsRaw.dry;
          }
          const params = sanitizeParams(paramsRaw);
          output.textContent = '⏳ Job en file…';
          button.disabled = true;
          try {
            const response = await fetch(form.dataset.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                params,
                dryRun,
                confirm: confirm || undefined,
                metadata: { source: 'admin-ui' }
              })
            });
            let data = {};
            try { data = await response.json(); } catch (_) {}
            if (!response.ok) {
              output.textContent = `✖ ${data.error || response.statusText}`;
            } else {
              const job = data.job || {};
              output.textContent = `✔ Job ${job.id || '—'} (${job.status || 'queued'})`;
              refreshAutomationJobs(scriptId, { highlightJobId: job.id });
              setTimeout(() => refreshAutomationJobs(scriptId), 4000);
            }
          } catch (err) {
            output.textContent = `✖ ${err && err.message ? err.message : err}`;
          } finally {
            button.disabled = false;
          }
        });
      };

      document.querySelectorAll('[data-script-form]').forEach(form => {
        const mode = form.dataset.mode || 'cli';
        if (mode === 'automation') {
          setupAutomationForm(form);
        } else {
          setupCliForm(form);
        }
      });

      document.querySelectorAll('[data-refresh-jobs]').forEach(btn => {
        const scriptId = btn.dataset.refreshJobs;
        btn.addEventListener('click', () => refreshAutomationJobs(scriptId));
      });

      Object.keys(AUTOMATION_JOBS_STATE || {}).forEach(scriptId => {
        renderAutomationJobs(scriptId);
      });

      document.querySelectorAll('[data-upload-form]').forEach(form => {
        form.addEventListener('submit', event => event.preventDefault());
        const trigger = form.querySelector('[data-upload-trigger]');
        const fileInput = form.querySelector('[data-upload-input]');
        const targetInput = form.querySelector('[data-upload-target]');
        const status = form.querySelector('[data-upload-status]');

        const resetStatus = () => { if (status) status.textContent = ''; };

        trigger?.addEventListener('click', () => {
          resetStatus();
          fileInput?.click();
        });

        fileInput?.addEventListener('change', () => {
          if (!fileInput.files || !fileInput.files.length) return;
          const file = fileInput.files[0];
          const desired = targetInput?.value?.trim() || file.name;
          if (status) status.textContent = '⏳ Upload en cours…';
          const reader = new FileReader();
          reader.onerror = () => {
            if (status) status.textContent = '✖ Lecture du fichier impossible';
            fileInput.value = '';
          };
          reader.onload = async () => {
            try {
              const dataUrl = reader.result;
              const base64 = typeof dataUrl === 'string' ? dataUrl.split(',').pop() : null;
              if (!base64) throw new Error('Encodage base64 invalide');
              const payload = {
                filename: desired,
                contentBase64: base64,
                subdir: form.dataset.uploadDir || ''
              };
              const response = await fetch(form.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
              let data;
              try {
                data = await response.json();
              } catch (parseErr) {
                data = {};
              }
              if (!response.ok || data.ok === false) {
                if (status) status.textContent = `✖ ${data.error || response.statusText}`;
              } else {
                if (status) status.textContent = `✔ Déposé sous ${data.filename || desired}`;
              }
            } catch (err) {
              if (status) status.textContent = `✖ ${err && err.message ? err.message : err}`;
            } finally {
              fileInput.value = '';
            }
          };
          reader.readAsDataURL(file);
        });
      });

      const bindDeleteButtons = () => {
        document.querySelectorAll('[data-delete-button]').forEach(button => {
          if (button.dataset.deleteBound === '1') return;
          button.dataset.deleteBound = '1';
          const originalLabel = button.dataset.label || button.textContent || 'Supprimer';
          button.addEventListener('click', async () => {
            const file = button.dataset.file || '';
            const url = button.dataset.deleteUrl || '';
            if (!file || !url) return;
            const confirmDelete = window.confirm(`Supprimer ${file} ?`);
            if (!confirmDelete) return;
            button.disabled = true;
            button.textContent = '…';
            try {
              const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ file })
              });
              let data = {};
              try { data = await response.json(); } catch (_) {}
              if (!response.ok || data.ok === false) {
                alert(data.error || response.statusText);
              } else {
                const parent = button.closest('li');
                if (parent) parent.remove();
              }
            } catch (err) {
              alert(err && err.message ? err.message : err);
            } finally {
              button.disabled = false;
              button.textContent = originalLabel;
            }
          });
        });
      };
      bindDeleteButtons();

      /* ----- Attendance modal wiring ----- */
      const defaultEventSlug = <%- JSON.stringify((locals.monitoring && locals.monitoring.event && locals.monitoring.event.selectedEvent && locals.monitoring.event.selectedEvent.slug) ? locals.monitoring.event.selectedEvent.slug : '') %>;
      const attendanceBase = <%- JSON.stringify(urlFor('/admin/events')) %>;
      const attendanceSuffix = <%- JSON.stringify(tokenSuffix || '') %>;

      const buildAttendanceUrl = (eventSlug, orderId) => {
        const base = attendanceBase || '';
        const suffix = attendanceSuffix || '';
        return `${base}/${encodeURIComponent(eventSlug)}/orders/${encodeURIComponent(orderId)}/attendance${suffix}`;
      };

      const attendanceModal = document.querySelector('[data-attendance-modal]');
      const attendanceBody = attendanceModal?.querySelector('[data-attendance-body]') || null;
      const attendanceSubmit = attendanceModal?.querySelector('[data-attendance-submit]') || null;
      let attendanceState = {
        eventSlug: null,
        orderId: null,
        lineIndex: null,
        order: null
      };

      const closeAttendance = () => {
        if (!attendanceModal) return;
        attendanceModal.classList.add('hidden');
        if (attendanceBody) attendanceBody.innerHTML = '<div class="empty-state">Chargement…</div>';
        attendanceState = { eventSlug: null, orderId: null, lineIndex: null, order: null };
        if (attendanceSubmit) {
          attendanceSubmit.disabled = false;
          attendanceSubmit.textContent = 'Enregistrer';
        }
      };

      const openAttendance = () => {
        if (!attendanceModal) return;
        attendanceModal.classList.remove('hidden');
      };

      document.querySelectorAll('[data-attendance-close]').forEach(btn => {
        btn.addEventListener('click', closeAttendance);
      });

      const renderAttendanceForm = (order) => {
        if (!attendanceBody) return;
        if (!order?.lines?.length) {
          attendanceBody.innerHTML = '<div class="empty-state">Commande vide.</div>';
          return;
        }

        attendanceState.order = order;
        const options = order.lines.map(line => {
          const label = line.seatId || line.placement?.seatId || line.zoneKey || `Ligne ${line.index + 1}`;
          return `<option value="${line.index}">${escapeHtml(label)}</option>`;
        }).join('');

        const getLine = (idx) => order.lines[idx] || order.lines[0];
        const current = getLine(order.lines[0]?.index ?? 0);
        const currentStatus = current?.attendance?.status || 'kept';
        const currentSeat = current?.attendance?.overrideSeatId || '';
        const currentZone = current?.attendance?.overrideZoneKey || '';
        const currentNote = current?.attendance?.note || '';

        attendanceBody.innerHTML = `
          <form data-attendance-form>
            <div class="form-group">
              <label>Ligne</label>
              <select name="lineIndex" data-attendance-line>
                ${options}
              </select>
            </div>
            <div class="form-group">
              <label>Statut</label>
              <select name="status" data-attendance-status>
                <option value="kept" ${currentStatus === 'kept' ? 'selected' : ''}>Conserver</option>
                <option value="released" ${currentStatus === 'released' ? 'selected' : ''}>Libérer</option>
                <option value="moved" ${currentStatus === 'moved' ? 'selected' : ''}>Déplacer</option>
              </select>
            </div>
            <div class="form-group">
              <label>Siège alternatif</label>
              <input type="text" name="overrideSeatId" data-attendance-seat value="${escapeHtml(currentSeat)}" placeholder="ex: N5-J-057" />
            </div>
            <div class="form-group">
              <label>Zone alternative</label>
              <input type="text" name="overrideZoneKey" data-attendance-zone value="${escapeHtml(currentZone)}" placeholder="Zone (optionnel)" />
            </div>
            <div class="form-group">
              <label>Note</label>
              <textarea name="note" data-attendance-note rows="2">${escapeHtml(currentNote)}</textarea>
            </div>
            <div class="form-help">Déplacer &rarr; indiquer siège ou zone. Libérer peut laisser vide.</div>
          </form>
        `;

        const lineSelect = attendanceBody.querySelector('[data-attendance-line]');
        if (lineSelect) {
          lineSelect.value = String(current?.index ?? order.lines[0].index);
          attendanceState.lineIndex = Number(lineSelect.value);
          lineSelect.addEventListener('change', () => {
            const idx = Number(lineSelect.value);
            const line = getLine(idx);
            const st = line?.attendance?.status || 'kept';
            const seat = line?.attendance?.overrideSeatId || '';
            const zone = line?.attendance?.overrideZoneKey || '';
            const note = line?.attendance?.note || '';
            attendanceBody.querySelector('[data-attendance-status]').value = st;
            attendanceBody.querySelector('[data-attendance-seat]').value = seat;
            attendanceBody.querySelector('[data-attendance-zone]').value = zone;
            attendanceBody.querySelector('[data-attendance-note]').value = note;
            attendanceState.lineIndex = idx;
          });
        }
      };

      const fetchAttendance = async () => {
        if (!attendanceState.eventSlug || !attendanceState.orderId) return;
        try {
          const endpoint = buildAttendanceUrl(attendanceState.eventSlug, attendanceState.orderId);
          const res = await fetch(endpoint, { headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error('Chargement impossible');
          const data = await res.json();
          if (!data?.ok) throw new Error(data?.error || 'Erreur API');
          renderAttendanceForm(data.order);
          const totals = data.attendanceSummary || null;
          const summaryTarget = document.querySelector('[data-attendance-summary]');
          if (totals && summaryTarget) {
            summaryTarget.innerHTML = `Gardées: ${totals.kept || 0} — Libérées: ${totals.released || 0} — Déplacées: ${totals.moved || 0}`;
          }
        } catch (err) {
          if (attendanceBody) attendanceBody.innerHTML = `<div class="error">${escapeHtml(err.message || 'Erreur inconnue')}</div>`;
        }
      };

      const submitAttendance = async () => {
        if (!attendanceState.eventSlug || !attendanceState.orderId) return;
        if (!attendanceBody) return;
        const form = attendanceBody.querySelector('[data-attendance-form]');
        if (!form) return;
        const lineIndex = attendanceState.lineIndex ?? Number(form.querySelector('[data-attendance-line]')?.value || 0);
        const status = form.querySelector('[data-attendance-status]')?.value || 'kept';
        const seat = form.querySelector('[data-attendance-seat]')?.value || '';
        const zone = form.querySelector('[data-attendance-zone]')?.value || '';
        const note = form.querySelector('[data-attendance-note]')?.value || '';

        const endpoint = buildAttendanceUrl(attendanceState.eventSlug, attendanceState.orderId);
        if (attendanceSubmit) attendanceSubmit.disabled = true;
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify({ lineIndex, status, overrideSeatId: seat, overrideZoneKey: zone, note })
          });
          const data = await res.json();
          if (!res.ok || !data?.ok) {
            throw new Error(data?.error || 'Enregistrement impossible');
          }
          renderAttendanceForm(data.order);
          const totals = data.attendanceSummary || null;
          const summaryTarget = document.querySelector('[data-attendance-summary]');
          if (totals && summaryTarget) {
            summaryTarget.innerHTML = `Gardées: ${totals.kept || 0} — Libérées: ${totals.released || 0} — Déplacées: ${totals.moved || 0}`;
          }
          attendanceState.order = data.order;
          if (attendanceSubmit) {
            attendanceSubmit.disabled = false;
            attendanceSubmit.textContent = 'Enregistré';
            setTimeout(() => { attendanceSubmit.textContent = 'Enregistrer'; }, 1200);
          }
          const block = document.querySelector('[data-event-orders-block]');
          if (block) block.setAttribute('data-needs-refresh', '1');
        } catch (err) {
          if (attendanceSubmit) {
            attendanceSubmit.disabled = false;
            attendanceSubmit.textContent = 'Réessayer';
          }
          const alert = document.createElement('div');
          alert.className = 'error';
          alert.textContent = err.message || 'Erreur inconnue';
          attendanceBody?.prepend(alert);
        }
      };

      if (attendanceSubmit) {
        attendanceSubmit.addEventListener('click', submitAttendance);
      }

      document.querySelectorAll('[data-attendance-edit]').forEach(btn => {
        btn.addEventListener('click', () => {
          const orderId = btn.dataset.orderId;
          const container = btn.closest('[data-event-orders-block]');
          const eventSlug = container?.dataset.eventSlug || defaultEventSlug;
          if (!orderId || !eventSlug) return;
          attendanceState = { eventSlug, orderId, lineIndex: null, order: null };
          openAttendance();
          fetchAttendance();
        });
      });

      document.addEventListener('keydown', (evt) => {
        if (evt.key === 'Escape' && attendanceModal && !attendanceModal.classList.contains('hidden')) {
          closeAttendance();
        }
      });

      attendanceModal?.addEventListener('click', (evt) => {
        if (evt.target === attendanceModal) {
          closeAttendance();
        }
      });

    })();
  </script>
</body>
</html>
