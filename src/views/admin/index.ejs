          <div class="empty-state" style="margin-top:12px;">Aucune entrée pour ce catalogue.</div>
        <% } %>
      <% } else { %>
        <div class="empty-state">Aucun catalogue de prix à afficher.</div>
      <% } %>
    </div>
    <div class="monitoring-panel <%= monitorTab === 'seasons' ? 'active' : '' %>" data-monitor-panel="seasons">
      <h3>Abonnement</h3>
      <% if (monitoring.subscription.selectedSeasonCode) { %>
        <form method="get" class="inline-filter-form">
          <% if (token) { %><input type="hidden" name="token" value="<%= token %>"><% } %>
          <input type="hidden" name="view" value="monitoring">
          <input type="hidden" name="monitorTab" value="seasons">
          <% if (monitoring.event.selectedEventSlug) { %><input type="hidden" name="event" value="<%= monitoring.event.selectedEventSlug %>"><% } %>
          <label>
            Saison
            <select name="season" data-auto-submit="change">
              <% for (const s of monitoring.lists.seasons) { %>
                <option value="<%= s.code %>" <%= s.code === monitoring.subscription.selectedSeasonCode ? 'selected' : '' %>>
                  <%= s.code %><%= s.name ? ' — ' + s.name : '' %>
                </option>
              <% } %>
            </select>
          </label>
          <label>
            Lieu
            <select name="venue" data-auto-submit="change">
              <% for (const v of monitoring.lists.venues) { %>
                <option value="<%= v.slug %>" <%= v.slug === monitoring.subscription.selectedVenueSlug ? 'selected' : '' %>>
                  <%= v.slug %>
                </option>
              <% } %>
            </select>
          </label>
          <noscript><button type="submit" class="btn btn-small">Mettre à jour</button></noscript>
        </form>

        <div class="monitoring-grid">
          <section class="card">
            <h4>Statut des commandes</h4>
            <% const subStats = monitoring.subscription.orderStats || {}; const subStatKeys = Object.keys(subStats); %>
