<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>BTS — Administration</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #fafafa;
      --fg: #222;
      --muted: #666;
      --border: #e2e2e2;
      --accent: #2360c6;
      --danger: #b3001e;
      --success: #0b7d2b;
      --warn: #b36b00;
      --card-bg: #fff;
    }
    * { box-sizing: border-box; }
    body {
      font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      margin: 24px;
      background: var(--bg);
      color: var(--fg);
    }
    h1 { font-size: 20px; margin: 0 0 20px; }
    h2 { font-size: 16px; margin: 0 0 8px; }
    h3 { font-size: 15px; margin: 16px 0 8px; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      box-shadow: 0 1px 1px rgba(0,0,0,0.04);
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      border: 1px solid var(--border);
      padding: 6px 8px;
      text-align: left;
    }
    .pill {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      background: #eee;
      font-size: 12px;
    }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    .warn { color: var(--warn); }
    .danger { color: var(--danger); }
    .success { color: var(--success); }
    .btn {
      display: inline-block;
      margin-top: 8px;
      padding: 6px 10px;
      border: 1px solid var(--border);
      border-radius: 8px;
      text-decoration: none;
      color: inherit;
      background: #fff;
      font-weight: 500;
      transition: background 0.15s;
    }
    .btn:hover { background: #f3f6ff; }
    .btn-small { padding: 4px 8px; font-size: 12px; margin-left: 6px; margin-top: 0; }
    .btn-link { border: none; background: transparent; color: var(--accent); padding: 0; margin-left: 8px; cursor: pointer; font-weight: 500; }
    .btn-link:hover { text-decoration: underline; background: transparent; }
    .scripts-card {
      margin-top: 24px;
    }
    .script-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
    }
    .tab-stack {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .script-tab {
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: transparent;
      cursor: pointer;
      font: inherit;
      transition: background 0.15s, border-color 0.15s;
    }
    .script-tab.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .script-group {
      display: none;
      gap: 16px;
    }
    .script-group.active { display: grid; }
    .script-item {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      background: #fff;
      box-shadow: 0 1px 1px rgba(0,0,0,0.03);
    }
    .script-item.danger {
      border-color: var(--danger);
    }
    .script-item header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
    }
    .script-item header .title {
      font-weight: 600;
      font-size: 15px;
    }
    .script-item header .badge {
      font-size: 12px;
      padding: 2px 6px;
      border-radius: 8px;
      background: #f3f3f3;
      border: 1px solid var(--border);
    }
    .script-desc { margin: 12px 0; color: var(--muted); }
    .script-meta { margin-bottom: 12px; font-size: 13px; color: var(--muted); }
    .script-meta code {
      display: inline-block;
      padding: 2px 4px;
      background: #f5f5f5;
      border-radius: 6px;
      border: 1px solid #e1e1e1;
      font-size: 12px;
    }
    form.script-runner {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 8px;
    }
    form.script-runner input[type="text"],
    form.script-runner input[type="password"] {
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font: inherit;
    }
    form.script-runner button {
      align-self: flex-start;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid var(--accent);
      background: var(--accent);
      color: #fff;
      cursor: pointer;
      font-weight: 500;
      transition: background 0.15s;
    }
    form.script-runner button[disabled] {
      opacity: 0.5;
      cursor: wait;
    }
    .script-output {
      border-radius: 8px;
      border: 1px solid #e1e1e1;
      background: #f7f7f7;
      padding: 8px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 12px;
      white-space: pre-wrap;
      min-height: 24px;
    }
    .file-list{list-style:none;padding:0;margin:0}
    .file-list li{display:flex;align-items:center;gap:8px;padding:4px 0;border-bottom:1px solid var(--border)}
    .file-list code{flex:1}
    .file-meta{font-size:12px;color:var(--muted)}
    .inline-form{display:inline-flex;align-items:center;gap:6px;margin-left:6px}
    .inline-form input[type="text"]{padding:4px 6px;font-size:12px;border-radius:6px;border:1px solid var(--border);width:140px}
    .inline-form input[type="file"]{display:none}
    .upload-status{font-size:12px;color:var(--muted);margin-left:6px;min-height:16px}
    .templates, .notes {
      margin: 8px 0;
      padding-left: 16px;
      color: var(--muted);
    }
    .templates li,
    .notes li {
      margin-bottom: 4px;
    }
    .script-form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 8px 12px;
      margin-top: 4px;
    }
    .script-form-grid label {
      display: flex;
      flex-direction: column;
      font-size: 13px;
      color: var(--muted);
    }
    .script-form-grid label span {
      font-weight: 500;
      color: inherit;
    }
    .script-form-grid label input[type="text"] {
      margin-top: 4px;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font: inherit;
      color: var(--fg);
    }
    .field-hint {
      display: block;
      margin-top: 4px;
      font-size: 11px;
      font-weight: 400;
      color: var(--muted);
    }
    .script-form-grid label.checkbox {
      flex-direction: row;
      align-items: center;
      gap: 8px;
      margin-top: 8px;
    }
    .script-form-grid label.checkbox input[type="checkbox"] {
      margin: 0;
    }
    .script-form-grid label.checkbox span {
      font-weight: 500;
    }
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }
    .topbar h1 {
      margin: 0;
    }
    .main-nav {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .main-nav a {
      padding: 8px 14px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: #fff;
      color: inherit;
      text-decoration: none;
      font-weight: 600;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .main-nav a.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .operations-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .monitoring-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .monitoring-tabs {
      margin: 16px 0;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .monitoring-tabs .script-tab {
      flex: 0 0 auto;
    }
    .monitoring-panel {
      display: none;
    }
    .monitoring-panel.active {
      display: block;
    }
    .metrics-list {
      list-style: none;
      padding: 0;
      margin: 8px 0 0;
    }
    .metrics-list li {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 4px;
      font-size: 13px;
    }
    .inline-filter-form {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 16px;
      align-items: flex-end;
    }
    .inline-filter-form label {
      display: flex;
      flex-direction: column;
      font-size: 13px;
      color: var(--muted);
    }
    .inline-filter-form select {
      margin-top: 4px;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font: inherit;
    }
    .inputs-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .inputs-header h2 {
      margin: 0;
    }
    .inputs-header form {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
    }
    .btn-upload {
      padding: 6px 12px;
      border-radius: 8px;
      border: none;
      background: var(--accent);
      color: #0b1020;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-upload:disabled {
      opacity: 0.5;
      cursor: default;
    }
    .scroll-limited {
      max-height: calc(5 * 48px);
      overflow-y: auto;
    }
    .scroll-table {
      max-height: 240px;
      overflow: auto;
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .scroll-table table {
      margin: 0;
    }
    .empty-state {
      color: var(--muted);
      font-size: 13px;
      padding: 8px 0;
    }
  </style>
</head>
<body>
  <header class="topbar">
    <h1>BTS — Administration</h1>
    <nav class="main-nav">
      <% const tokenQueryString = tokenQuery ? ('?' + tokenQuery) : ''; %>
      <a href="<%= urlFor('/admin/operate') %><%= tokenQueryString %>" class="<%= viewMode === 'operate' ? 'active' : '' %>">Exploitation</a>
      <a href="<%= urlFor('/admin/monitor') %><%= tokenQueryString %>" class="<%= viewMode === 'monitor' ? 'active' : '' %>">Monitoring</a>
    </nav>
  </header>

  <% if (viewMode === 'operate') { %>
    <div class="operations-grid">
      <section class="card">
        <div class="inputs-header">
          <h2>Entrées disponibles (data/inputs)</h2>
          <% const uploadAction = urlFor('/admin/uploads') + (tokenSuffix || ''); %>
          <form class="inline-form" data-upload-form data-upload-dir="" action="<%= uploadAction %>" method="post">
            <input type="file" name="file" data-upload-input hidden />
            <input type="hidden" name="targetName" data-upload-target />
            <button type="button" class="btn-upload" data-upload-trigger>Uploader</button>
            <span class="upload-status" data-upload-status></span>
          </form>
        </div>
        <% if (!inputsList || !inputsList.length) { %>
          <div class="muted">Ajoutez vos CSV/SVG grâce au bouton ci-dessus.</div>
        <% } else { %>
          <ul class="file-list scroll-limited">
            <% for (const file of inputsList || []) {
                 const dlUrl = urlFor('/admin/inputs/download') + '?file=' + encodeURIComponent(file.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
            %>
              <li>
                <code><%= file.name %></code>
                <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                <a class="btn btn-small" href="<%= dlUrl %>">Télécharger</a>
              </li>
            <% } %>
          </ul>
        <% } %>
      </section>

      <section class="card">
        <h2>Fichiers générés (data/outputs)</h2>
        <% if (!outputsList || !outputsList.length) { %>
          <div class="muted">Aucun export enregistré pour le moment.</div>
        <% } else { %>
          <ul class="file-list scroll-limited">
            <% for (const file of outputsList || []) {
                 const dlUrl = urlFor('/admin/outputs/download') + '?file=' + encodeURIComponent(file.rel) + (token ? '&token=' + encodeURIComponent(token) : '');
            %>
              <li>
                <code><%= file.name %></code>
                <span class="file-meta"><%= (file.size/1024).toFixed(1) %> KB</span>
                <span class="file-meta"><%= new Date(file.mtime).toLocaleString() %></span>
                <a class="btn btn-small" href="<%= dlUrl %>">Télécharger</a>
              </li>
            <% } %>
          </ul>
        <% } %>
      </section>
    </div>

    <section class="card scripts-card">
      <h2>Scripts opérationnels</h2>
      <p style="color: var(--muted); margin-bottom: 16px;">
        Les scripts sont organisés par thématique. Ajoutez des arguments optionnels dans le champ prévu puis exécutez. Les chemins de template sont indiqués pour faciliter la préparation des fichiers.
      </p>
      <div class="script-tabs">
        <% const renewalGroup = (scriptGroups || []).find(g => g.id === '03-season-management-renewal'); %>
        <% (scriptGroups || []).forEach(group => {
             if (group.id === '03-season-management-renewal') return;
             if (group.id === '03-season-management' && renewalGroup) { %>
          <div class="tab-stack">
            <button
              type="button"
              class="script-tab <%= group.id === activeGroupId ? 'active' : '' %>"
              data-tab="<%= group.id %>">
              <%= group.label %>
            </button>
            <button
              type="button"
              class="script-tab <%= renewalGroup.id === activeGroupId ? 'active' : '' %>"
              data-tab="<%= renewalGroup.id %>">
              <%= renewalGroup.label %>
            </button>
          </div>
        <%   } else { %>
          <button
            type="button"
            class="script-tab <%= group.id === activeGroupId ? 'active' : '' %>"
            data-tab="<%= group.id %>">
            <%= group.label %>
          </button>
        <%   }
           }); %>
      </div>

      <% for (const group of scriptGroups || []) { %>
        <div class="script-group <%= group.id === activeGroupId ? 'active' : '' %>" data-script-group="<%= group.id %>">
          <% for (const script of group.scripts || []) {
               const runUrl = urlFor('/admin/scripts/' + script.id + '/run') + (tokenSuffix || '');
          %>
            <article class="script-item <%= script.danger ? 'danger' : '' %>">
              <header>
                <div class="title"><%= script.label %></div>
                <div class="badge">#<%= script.order != null ? script.order.toString().padStart(2,'0') : '—' %></div>
              </header>
              <div class="script-desc"><%= script.description %></div>
              <div class="script-meta">
                <div><strong>Commande</strong> : <code><%= script.command %></code></div>
                <% if (script.templates && script.templates.length) { %>
                  <div>Templates :</div>
                  <ul class="templates">
                    <% for (const t of script.templates) {
                         const templateDownloadUrl = urlFor('/admin/templates/download') + '?path=' + encodeURIComponent(t) + (token ? '&token=' + encodeURIComponent(token) : '');
                    %>
                      <li>
                        <code><%= t %></code>
                        <a class="btn btn-small" href="<%= templateDownloadUrl %>">Télécharger</a>
                      </li>
                    <% } %>
                  </ul>
                <% } %>
                <% if (script.notes && script.notes.length) { %>
                  <div>Notes :</div>
                  <ul class="notes">
                    <% for (const note of script.notes) { %>
                      <li><%= note %></li>
                    <% } %>
                  </ul>
                <% } %>
                <% if (script.danger) { %>
                  <div class="danger">Action dangereuse — confirmation obligatoire (<code><%= script.id %></code>).</div>
                <% } %>
              </div>

              <form class="script-runner" data-script-form data-script-id="<%= script.id %>" data-action="<%= runUrl %>">
                <% if (script.form && script.form.fields && script.form.fields.length) { %>
                  <div class="script-form-grid">
                    <% for (const field of script.form.fields) { 
                         const inputRole = script.id + ':' + field.name;
                         const fieldType = field.type || 'text';
                    %>
                      <% if (fieldType === 'checkbox') { %>
                        <label class="checkbox">
                          <input type="checkbox" data-role="<%= inputRole %>" />
                          <span>
                            <%= field.label %>
                            <% if (field.hint) { %><small class="field-hint"><%= field.hint %></small><% } %>
                          </span>
                        </label>
                      <% } else { %>
                        <label>
                          <span><%= field.label %></span>
                          <input type="text" data-role="<%= inputRole %>" placeholder="<%= field.placeholder || '' %>" />
                          <% if (field.hint) { %><small class="field-hint"><%= field.hint %></small><% } %>
                        </label>
                      <% } %>
                    <% } %>
                  </div>
                <% } %>

                <label>
                  Arguments additionnels
                  <input type="text" name="argLine" placeholder="ex : --apply --dry-run --extra=value" />
                </label>
                <% if (script.danger) { %>
                <label>
                  Confirmation (<code><%= script.id %></code>)
                  <input type="text" name="confirm" placeholder="<%= script.id %>" />
                </label>
                <% } %>
                <button type="submit">Exécuter</button>
                <div class="script-output" data-output></div>
              </form>
            </article>
          <% } %>
        </div>
      <% } %>
    </section>
  <% } %>

  <% if (viewMode === 'monitor' && monitoring) { %>
    <div class="monitoring-grid">
      <section class="card">
        <h2>Application</h2>
        <div>Host : <span class="mono"><%= monitoring.summary.serverInfo.host %></span></div>
        <div>Node : <%= monitoring.summary.serverInfo.nodeVersion %></div>
        <div>Env : <span class="pill"><%= monitoring.summary.serverInfo.env %></span></div>
        <div>Base path : <span class="mono"><%= monitoring.summary.serverInfo.basePath %></span></div>
      </section>

      <section class="card">
        <h2>MongoDB</h2>
        <div>État : <strong><%= monitoring.summary.mongoState %></strong></div>
        <div class="muted" style="margin-top:8px;">Statut en temps réel de la connexion.</div>
      </section>

      <section class="card">
        <h2>Sièges (global)</h2>
        <% if (monitoring.summary.seatCounts && Object.keys(monitoring.summary.seatCounts).length) { %>
          <ul class="metrics-list">
            <% for (const [status, value] of Object.entries(monitoring.summary.seatCounts)) { %>
              <li><span><%= status %></span><span><%= value %></span></li>
            <% } %>
          </ul>
        <% } else { %>
          <div class="empty-state">Aucune donnée siège disponible.</div>
        <% } %>
      </section>

      <section class="card">
        <h2>Commandes (24h)</h2>
        <% if (monitoring.summary.recentOrders && monitoring.summary.recentOrders.length) { %>
          <ul class="metrics-list">
            <% for (const row of monitoring.summary.recentOrders) { %>
              <li><span><%= row._id || 'unknown' %></span><span><%= row.c %></span></li>
            <% } %>
          </ul>
        <% } else { %>
          <div class="empty-state">Aucune commande enregistrée sur les 24 dernières heures.</div>
        <% } %>
        <div style="margin-top:12px;">
          <a class="btn btn-small" href="<%= urlFor('/admin/export/orders.csv') %><%= tokenSuffix %>">Exporter commandes</a>
          <a class="btn btn-small" href="<%= urlFor('/admin/export/seats.csv') %><%= tokenSuffix %>" style="margin-left:8px;">Exporter sièges</a>
        </div>
      </section>

      <section class="card">
        <h2>PM2</h2>
        <% if (monitoring.summary.pm2 && monitoring.summary.pm2.length) { %>
          <div class="scroll-table">
            <table>
              <tr><th>Process</th><th>Status</th><th>CPU</th><th>RAM</th><th>Restarts</th></tr>
              <% for (const p of monitoring.summary.pm2.slice(0, 8)) { %>
                <tr>
                  <td><%= p.name %></td>
                  <td><%= p.status || '' %></td>
                  <td><%= p.cpu || 0 %>%</td>
                  <td><%= Math.round((p.mem || 0) / 1048576) %> MB</td>
                  <td><%= p.restarts || 0 %></td>
                </tr>
              <% } %>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">PM2 non disponible.</div>
        <% } %>
      </section>

    </div>
    <div class="script-tabs monitoring-tabs">
      <button type="button" class="script-tab <%= monitorTab === 'tariffs' ? 'active' : '' %>" data-monitor-button="tariffs">Tarifs</button>
      <button type="button" class="script-tab <%= monitorTab === 'subscription' ? 'active' : '' %>" data-monitor-button="subscription">Abonnements</button>
      <button type="button" class="script-tab <%= monitorTab === 'event' ? 'active' : '' %>" data-monitor-button="event">Événements</button>
    </div>

    <div class="monitoring-panel <%= monitorTab === 'tariffs' ? 'active' : '' %>" data-monitor-panel="tariffs">
      <h3>Résumé des tables de tarifs</h3>
      <% if (monitoring.lists.tariffSummary && monitoring.lists.tariffSummary.length) { %>
        <div class="scroll-table" style="margin-bottom:16px;">
          <table>
            <tr><th>Table</th><th>Tarifs</th><th>Actifs</th><th>Entrées de prix</th></tr>
            <% for (const row of monitoring.lists.tariffSummary) { %>
              <tr>
                <td><%= row.priceTableKey === 'global' ? 'Global (abonnements)' : row.priceTableKey %></td>
                <td><%= row.total %></td>
                <td><%= row.active %></td>
                <td><%= row.priceEntries %></td>
              </tr>
            <% } %>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">Aucune table tarifaire configurée.</div>
      <% } %>

      <h3>Tarifs (extraits)</h3>
      <% if (monitoring.lists.tariffs && monitoring.lists.tariffs.length) { %>
        <div class="scroll-table">
          <table>
            <tr><th>Code</th><th>Libellé</th><th>Actif</th><th>Table</th></tr>
            <% for (const t of monitoring.lists.tariffs) { %>
              <tr>
                <td><code><%= t.code %></code></td>
                <td><%= t.label %></td>
                <td><%= t.active ? 'Oui' : 'Non' %></td>
                <td><%= t.priceTableKey || 'Global' %></td>
              </tr>
            <% } %>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">Aucun tarif disponible.</div>
      <% } %>
    </div>

    <div class="monitoring-panel <%= monitorTab === 'subscription' ? 'active' : '' %>" data-monitor-panel="subscription">
      <h3>Abonnement</h3>
      <% if (monitoring.subscription.selectedSeasonCode) { %>
        <form method="get" class="inline-filter-form">
          <% if (token) { %><input type="hidden" name="token" value="<%= token %>"><% } %>
          <input type="hidden" name="view" value="monitoring">
          <input type="hidden" name="monitorTab" value="subscription">
          <% if (monitoring.event.selectedEventSlug) { %><input type="hidden" name="event" value="<%= monitoring.event.selectedEventSlug %>"><% } %>
          <label>
            Saison
            <select name="season" data-auto-submit="change">
              <% for (const s of monitoring.lists.seasons) { %>
                <option value="<%= s.code %>" <%= s.code === monitoring.subscription.selectedSeasonCode ? 'selected' : '' %>>
                  <%= s.code %><%= s.name ? ' — ' + s.name : '' %>
                </option>
              <% } %>
            </select>
          </label>
          <label>
            Lieu
            <select name="venue" data-auto-submit="change">
              <% for (const v of monitoring.lists.venues) { %>
                <option value="<%= v.slug %>" <%= v.slug === monitoring.subscription.selectedVenueSlug ? 'selected' : '' %>>
                  <%= v.slug %>
                </option>
              <% } %>
            </select>
          </label>
          <noscript><button type="submit" class="btn btn-small">Mettre à jour</button></noscript>
        </form>

        <div class="monitoring-grid">
          <section class="card">
            <h4>Statut des commandes</h4>
            <% const subStats = monitoring.subscription.orderStats || {}; const subStatKeys = Object.keys(subStats); %>
            <% if (subStatKeys.length) { %>
              <ul class="metrics-list">
                <% for (const key of subStatKeys) { %>
                  <li>
                    <span><%= key %></span>
                    <span><%= subStats[key].count %> (<%= ((subStats[key].totalCents || 0)/100).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' }) %>)</span>
                  </li>
                <% } %>
              </ul>
            <% } else { %>
              <div class="empty-state">Aucune commande pour cette sélection.</div>
            <% } %>
          </section>
          <section class="card">
            <h4>Sièges par statut</h4>
            <% const subSeats = monitoring.subscription.seatCounts || {}; const subSeatKeys = Object.keys(subSeats); %>
            <% if (subSeatKeys.length) { %>
              <ul class="metrics-list">
                <% for (const key of subSeatKeys) { %>
                  <li><span><%= key %></span><span><%= subSeats[key] %></span></li>
                <% } %>
              </ul>
            <% } else { %>
              <div class="empty-state">Pas de sièges correspondants.</div>
            <% } %>
          </section>
        </div>

        <div class="monitoring-grid">
          <section class="card">
            <h4>Commandes récentes</h4>
            <% if (monitoring.subscription.orders && monitoring.subscription.orders.length) { %>
              <div class="scroll-table">
                <table>
                  <tr><th>ID</th><th>Créée</th><th>Status</th><th>Email</th><th>Lignes</th><th>Total</th></tr>
            <% for (const o of monitoring.subscription.orders || []) { %>
              <tr>
                <td><code><%= o.id %></code></td>
                <td><%= o.createdAt ? new Date(o.createdAt).toLocaleString() : '—' %></td>
                <td><%= o.status %></td>
                <td><%= o.payerEmail || '—' %></td>
                <td><%= o.lineCount %></td>
                <td><%= ((o.totalCents || 0)/100).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' }) %></td>
              </tr>
            <% } %>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state">Aucune commande.</div>
            <% } %>
          </section>

          <section class="card">
            <h4>Tickets récents</h4>
            <% if (monitoring.subscription.tickets && monitoring.subscription.tickets.length) { %>
              <div class="scroll-table">
                <table>
                  <tr><th>ID</th><th>Siège</th><th>Tarif</th><th>Événement</th><th>Créé</th></tr>
            <% for (const t of monitoring.subscription.tickets || []) { %>
              <tr>
                <td><code><%= t.id %></code></td>
                <td><%= t.seatId || '—' %></td>
                <td><%= t.tariffCode || '—' %></td>
                <td><%= t.eventId || '—' %></td>
                <td><%= t.createdAt ? new Date(t.createdAt).toLocaleString() : '—' %></td>
              </tr>
            <% } %>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state">Aucun ticket généré.</div>
            <% } %>
          </section>

          <section class="card">
            <h4>Sièges récemment mis à jour</h4>
            <% if (monitoring.subscription.seats && monitoring.subscription.seats.length) { %>
              <div class="scroll-table">
                <table>
                  <tr><th>Siège</th><th>Zone</th><th>Status</th><th>Maj</th></tr>
            <% for (const s of monitoring.subscription.seats || []) { %>
              <tr>
                <td><%= s.seatId %></td>
                <td><%= s.zoneKey || '—' %></td>
                <td><%= s.status || '—' %></td>
                <td><%= s.updatedAt ? new Date(s.updatedAt).toLocaleString() : '—' %></td>
              </tr>
            <% } %>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state">Aucun siège modifié récemment.</div>
            <% } %>
          </section>
        </div>
      <% } else { %>
        <div class="empty-state">Aucune saison sélectionnable.</div>
      <% } %>
    </div>

    <div class="monitoring-panel <%= monitorTab === 'event' ? 'active' : '' %>" data-monitor-panel="event">
      <h3>Événement</h3>
      <% if (monitoring.event && monitoring.event.selectedEvent) { %>
        <form method="get" class="inline-filter-form">
          <% if (token) { %><input type="hidden" name="token" value="<%= token %>"><% } %>
          <input type="hidden" name="view" value="monitoring">
          <input type="hidden" name="monitorTab" value="event">
          <% if (monitoring.subscription.selectedSeasonCode) { %><input type="hidden" name="season" value="<%= monitoring.subscription.selectedSeasonCode %>"><% } %>
          <% if (monitoring.subscription.selectedVenueSlug) { %><input type="hidden" name="venue" value="<%= monitoring.subscription.selectedVenueSlug %>"><% } %>
          <label>
            Événement
            <select name="event" data-auto-submit="change">
          <% for (const ev of monitoring.lists.events || []) { %>
            <option value="<%= ev.slug %>" <%= ev.slug === monitoring.event.selectedEventSlug ? 'selected' : '' %>>
              <%= ev.slug %>
            </option>
          <% } %>
            </select>
          </label>
          <noscript><button type="submit" class="btn btn-small">Mettre à jour</button></noscript>
        </form>

        <section class="card">
          <h4>Détails</h4>
          <div><strong><%= monitoring.event.selectedEvent.name %></strong></div>
          <div>Date : <%= monitoring.event.selectedEvent.startsAt ? new Date(monitoring.event.selectedEvent.startsAt).toLocaleString() : '—' %></div>
          <div>Saison : <%= monitoring.event.selectedEvent.seasonCode || '—' %></div>
          <div>Lieu : <%= monitoring.event.selectedEvent.venueSlug || '—' %></div>
          <div>En vente : <%= monitoring.event.selectedEvent.isOnSale ? 'Oui' : 'Non' %></div>
        </section>

        <div class="monitoring-grid">
          <section class="card">
            <h4>Statut des commandes</h4>
            <% const evStats = monitoring.event.orderStats || {}; const evStatKeys = Object.keys(evStats); %>
            <% if (evStatKeys.length) { %>
              <ul class="metrics-list">
                <% evStatKeys.forEach(key => { %>
                  <li>
                    <span><%= key %></span>
                    <span><%= evStats[key].count %> (<%= ((evStats[key].totalCents || 0)/100).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' }) %>)</span>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="empty-state">Aucune commande pour cet événement.</div>
            <% } %>
          </section>
          <section class="card">
            <h4>Sièges</h4>
            <% const evSeatCounts = monitoring.event.seatCounts || {}; const evSeatKeys = Object.keys(evSeatCounts); %>
            <% if (evSeatKeys.length) { %>
              <ul class="metrics-list">
                <% evSeatKeys.forEach(key => { %>
                  <li><span><%= key %></span><span><%= evSeatCounts[key] %></span></li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="empty-state">Pas de données siège.</div>
            <% } %>
          </section>
        </div>

        <div class="monitoring-grid">
          <section class="card">
            <h4>Commandes récentes</h4>
            <% if (monitoring.event.orders && monitoring.event.orders.length) { %>
              <div class="scroll-table">
                <table>
                  <tr><th>ID</th><th>Créée</th><th>Status</th><th>Email</th><th>Lignes</th><th>Total</th></tr>
                  <% monitoring.event.orders.forEach(o => { %>
                    <tr>
                      <td><code><%= o.id %></code></td>
                      <td><%= o.createdAt ? new Date(o.createdAt).toLocaleString() : '—' %></td>
                      <td><%= o.status %></td>
                      <td><%= o.payerEmail || '—' %></td>
                      <td><%= o.lineCount %></td>
                      <td><%= ((o.totalCents || 0)/100).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' }) %></td>
                    </tr>
                  <% }) %>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state">Aucune commande récente.</div>
            <% } %>
          </section>

          <section class="card">
            <h4>Tickets</h4>
            <% if (monitoring.event.tickets && monitoring.event.tickets.length) { %>
              <div class="scroll-table">
                <table>
                  <tr><th>ID</th><th>Siège</th><th>Zone</th><th>Tarif</th><th>Scanné</th></tr>
                  <% monitoring.event.tickets.forEach(t => { %>
                    <tr>
                      <td><code><%= t.id %></code></td>
                      <td><%= t.seatId || '—' %></td>
                      <td><%= t.zoneKey || '—' %></td>
                      <td><%= t.tariffCode || '—' %></td>
                      <td><%= t.scannedAt ? new Date(t.scannedAt).toLocaleString() : 'Non' %></td>
                    </tr>
                  <% }) %>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state">Aucun ticket généré.</div>
            <% } %>
          </section>

          <section class="card">
            <h4>Abonnés liés</h4>
            <% if (monitoring.event.subscribers && monitoring.event.subscribers.length) { %>
              <div class="scroll-table">
                <table>
                  <tr><th>Nom</th><th>Email</th><th>Groupe</th><th>Sièges précédents</th></tr>
                  <% monitoring.event.subscribers.forEach(s => { %>
                    <tr>
                      <td><%= (s.firstName || '') + ' ' + (s.lastName || '') %></td>
                      <td><%= s.email || '—' %></td>
                      <td><%= s.groupKey || '—' %></td>
                      <td><%= s.previousSeats && s.previousSeats.length ? s.previousSeats.join(', ') : '—' %></td>
                    </tr>
                  <% }) %>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state">Aucun abonné pour cet événement.</div>
            <% } %>
          </section>

          <section class="card">
            <h4>Logs de scans</h4>
            <% if (monitoring.event.scans && monitoring.event.scans.length) { %>
              <div class="scroll-table">
                <table>
                  <tr><th>Horodatage</th><th>Gate</th><th>OK</th><th>Raison</th></tr>
                  <% monitoring.event.scans.forEach(log => { %>
                    <tr>
                      <td><%= log.when ? new Date(log.when).toLocaleString() : '—' %></td>
                      <td><%= log.gate || '—' %></td>
                      <td><%= log.ok ? 'Oui' : 'Non' %></td>
                      <td><%= log.reason || '—' %></td>
                    </tr>
                  <% }) %>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state">Aucun scan enregistré.</div>
            <% } %>
          </section>
        </div>
      <% } else { %>
        <div class="empty-state">Sélectionnez un événement pour afficher les détails.</div>
      <% } %>
    </div>
  </div>

  <% } %>

  <script>
    const SCRIPT_FORMS = <%- JSON.stringify(scriptForms || {}).replace(/</g, '\\u003c') %>;
    (() => {
      const monitorTabs = document.querySelectorAll('[data-monitor-button]');
      const monitorPanels = document.querySelectorAll('[data-monitor-panel]');
      if (monitorTabs.length) {
        const active = '<%= monitorTab %>';
        const activate = (tab) => {
          monitorTabs.forEach(btn => btn.classList.toggle('active', btn.dataset.monitorButton === tab));
          monitorPanels.forEach(panel => panel.classList.toggle('active', panel.dataset.monitorPanel === tab));
        };
        monitorTabs.forEach(btn => {
          btn.addEventListener('click', () => activate(btn.dataset.monitorButton));
        });
        activate(active);
      }

      document.querySelectorAll('[data-auto-submit]').forEach(el => {
        el.addEventListener('change', () => {
          const form = el.closest('form');
          if (form) form.submit();
        });
      });

      const tabs = document.querySelectorAll('.script-tab');
      const groups = document.querySelectorAll('.script-group');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.dataset.tab;
          tabs.forEach(t => t.classList.toggle('active', t === tab));
          groups.forEach(g => g.classList.toggle('active', g.dataset.scriptGroup === target));
        });
      });

      const collectScriptArgs = (form, argLine) => {
        const scriptId = form.dataset.scriptId;
        if (!scriptId) return { args: [] };
        const schema = SCRIPT_FORMS?.[scriptId];
        if (!schema?.fields?.length) return { args: [] };

        const hasManualArgs = typeof argLine === 'string' && argLine.trim().length > 0;
        const values = {};
        let anyFieldValue = false;
        const missing = [];

        schema.fields.forEach(field => {
          const selector = `[data-role="${scriptId}:${field.name}"]`;
          const el = form.querySelector(selector);
          if (!el) return;
          const fieldType = field.type || 'text';
          let value;
          if (fieldType === 'checkbox') {
            value = !!el.checked;
            if (value) anyFieldValue = true;
            if (field.required && !value) missing.push(field.label || field.name);
          } else {
            value = (el.value || '').trim();
            if (value) anyFieldValue = true;
            if (field.required && !value) missing.push(field.label || field.name);
          }
          values[field.name] = value;
        });

        if (!anyFieldValue) {
          return { args: [] };
        }

        if (missing.length) {
          if (hasManualArgs) {
            return { args: [] };
          }
          return { error: `Champs requis : ${missing.join(', ')}` };
        }

        const positional = [];
        const trailing = [];

        schema.fields.forEach((field, index) => {
          const rule = field.arg;
          if (!rule) return;
          const value = values[field.name];
          const fieldType = field.type || 'text';
          const hasValue = fieldType === 'checkbox' ? !!value : value !== undefined && value !== null && value !== '';

          switch (rule.type) {
            case 'positional': {
              if (!hasValue) {
                if (!rule.optional) return;
              } else {
                positional.push({ order: rule.index ?? index, value });
              }
              break;
            }
            case 'option': {
              if (!hasValue) return;
              let rendered = rule.template || '';
              if (rendered.includes('${value}')) {
                rendered = rendered.replace(/\$\{value\}/g, value);
              } else if (rendered) {
                rendered = `${rendered}${value}`;
              } else {
                rendered = `--${field.name}=${value}`;
              }
              trailing.push({ order: rule.order ?? index, value: rendered });
              break;
            }
            case 'flag': {
              if (!hasValue) return;
              trailing.push({ order: rule.order ?? index, value: rule.flag || `--${field.name}` });
              break;
            }
            default:
              break;
          }
        });

        positional.sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
        trailing.sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

        const args = [
          ...positional.map(item => item.value),
          ...trailing.map(item => item.value)
        ];

        return { args };
      };

      document.querySelectorAll('[data-script-form]').forEach(form => {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const output = form.querySelector('[data-output]');
          const button = form.querySelector('button[type="submit"]');
          const argLine = form.querySelector('input[name="argLine"]')?.value || '';
          const confirm = form.querySelector('input[name="confirm"]')?.value || '';
          const collected = collectScriptArgs(form, argLine);
          if (collected.error) {
            output.textContent = `✖ ${collected.error}`;
            return;
          }
          const presetArgs = Array.isArray(collected.args) ? collected.args : [];
          output.textContent = '⏳ Exécution en cours…';
          button.disabled = true;
          try {
            const response = await fetch(form.dataset.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                argLine,
                confirm,
                ...(presetArgs.length ? { args: presetArgs } : {})
              })
            });
            let data;
            try {
              data = await response.json();
            } catch (parseErr) {
              data = {};
            }
            if (!response.ok) {
              output.textContent = `✖ ${data.error || response.statusText}`;
            } else {
              let text = `✔ exit ${data.exitCode}\n`;
              if (data.stdout) text += data.stdout.trim() + '\n';
              if (data.stderr) text += '\n[stderr]\n' + data.stderr.trim();
              output.textContent = text.trim();
            }
          } catch (err) {
            output.textContent = `✖ ${err && err.message ? err.message : err}`;
          } finally {
            button.disabled = false;
          }
        });
      });

      document.querySelectorAll('[data-upload-form]').forEach(form => {
        form.addEventListener('submit', event => event.preventDefault());
        const trigger = form.querySelector('[data-upload-trigger]');
        const fileInput = form.querySelector('[data-upload-input]');
        const targetInput = form.querySelector('[data-upload-target]');
        const status = form.querySelector('[data-upload-status]');

        const resetStatus = () => { if (status) status.textContent = ''; };

        trigger?.addEventListener('click', () => {
          resetStatus();
          fileInput?.click();
        });

        fileInput?.addEventListener('change', () => {
          if (!fileInput.files || !fileInput.files.length) return;
          const file = fileInput.files[0];
          const desired = targetInput?.value?.trim() || file.name;
          if (status) status.textContent = '⏳ Upload en cours…';
          const reader = new FileReader();
          reader.onerror = () => {
            if (status) status.textContent = '✖ Lecture du fichier impossible';
            fileInput.value = '';
          };
          reader.onload = async () => {
            try {
              const dataUrl = reader.result;
              const base64 = typeof dataUrl === 'string' ? dataUrl.split(',').pop() : null;
              if (!base64) throw new Error('Encodage base64 invalide');
              const payload = {
                filename: desired,
                contentBase64: base64,
                subdir: form.dataset.uploadDir || ''
              };
              const response = await fetch(form.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
              let data;
              try {
                data = await response.json();
              } catch (parseErr) {
                data = {};
              }
              if (!response.ok || data.ok === false) {
                if (status) status.textContent = `✖ ${data.error || response.statusText}`;
              } else {
                if (status) status.textContent = `✔ Déposé sous ${data.filename || desired}`;
              }
            } catch (err) {
              if (status) status.textContent = `✖ ${err && err.message ? err.message : err}`;
            } finally {
              fileInput.value = '';
            }
          };
          reader.readAsDataURL(file);
        });
      });
    })();
  </script>
</body>
</html>
