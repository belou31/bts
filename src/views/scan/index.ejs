<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="theme-color" content="#0b0f17"/>
  <title><%= title %></title>
  <link rel="manifest" href="<%= scope %>manifest.webmanifest">
  <link rel="stylesheet" href="<%= assetBase %>styles/scan.css">
</head>
<body>
  <header>
    <img alt="BTS" src="<%= assetBase %>img/logo.png" onerror="this.style.display='none'"/>
    <strong>Contrôle d'accès — BTS</strong>
    <span class="pill" id="net">offline</span>
  </header>

  <main>
    <div class="grid">
      <div class="row row-config">
        <div class="event-group">
          <label for="eventSelect">Événement</label>
          <div class="event-selector">
            <select id="eventSelect">
              <option value="">Chargement…</option>
            </select>
            <input id="eventId" type="hidden" />
          </div>
        </div>
        <div class="auth-group">
          <div class="auth-header">
            <span>Authentification</span>
            <div class="toggle auth-toggle" id="authToggle" role="switch" aria-checked="false" tabindex="0">
              <div class="toggle-track">
                <span class="toggle-option token" aria-hidden="true">Token</span>
                <span class="toggle-option login" aria-hidden="true">Login</span>
                <span class="toggle-thumb"><span class="toggle-label">Token</span></span>
              </div>
            </div>
          </div>
          <div class="auth-fields">
            <div class="auth-row auth-row-token">
              <input id="token" placeholder="Token" aria-label="Token"/>
            </div>
            <div class="auth-row auth-row-login auth-row-basic auth-hidden">
              <input id="login" placeholder="Login" autocomplete="username" aria-label="Login"/>
            </div>
            <div class="auth-row auth-row-password auth-row-basic auth-hidden">
              <input id="password" type="password" placeholder="Mot de passe" autocomplete="current-password" aria-label="Mot de passe"/>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="preview-wrapper">
      <video id="preview" playsinline></video>
      <canvas id="overlay"></canvas>
    </div>

    <div class="row controls-row">
      <div class="toggle scan-toggle" id="scanToggle" role="switch" aria-checked="false" tabindex="0">
        <div class="toggle-track">
          <span class="toggle-option off" aria-hidden="true">Scan OFF</span>
          <span class="toggle-option on" aria-hidden="true">Scan ON</span>
          <span class="toggle-thumb"><span class="toggle-label">Scan OFF</span></span>
        </div>
      </div>
      <button id="installBtn" style="display:none">Installer</button>
      <span class="pill" id="queueSize">0 en attente</span>
    </div>

    <div class="status" id="status">Prêt.</div>
    <section class="results" id="results"></section>
  </main>

  <script>
    // Variables fournies par le serveur (fallback côté client si besoin)
    window.__BTS__ = {
      basePath: <%- JSON.stringify(basePath) %>,
      scope:    <%- JSON.stringify(scope) %>
    };
  </script>
  <script src="<%= assetBase %>js/scan.js"></script>
</body>
</html>
