<!doctype html>
<html lang="<%= (typeof lang !== 'undefined' && lang) ? lang : 'fr' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t('pay.resumeTitle') %></title>
  <link rel="icon" href="<%= assets.media %>favicon.ico">
  <style>
    :root { color-scheme: dark; }
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh;
      background: #0b0f14; color: #e8eef5;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      display: flex; flex-direction: column; align-items: center;
      padding: 32px 16px;
    }
    .pay-card {
      width: 100%; max-width: 480px;
      background: #111b28;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      overflow: hidden;
    }
    .pay-header {
      padding: 20px 24px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .pay-header img { height: 40px; width: auto; }
    .pay-title {
      margin: 10px 0 0;
      font-size: 1.1rem; font-weight: 600; color: #fff;
    }
    .pay-lead {
      margin: 4px 0 0;
      font-size: 0.85rem; color: rgba(255,255,255,0.6);
    }
    .pay-recap {
      padding: 16px 24px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      font-size: 0.9rem;
    }
    .pay-recap .desc { color: rgba(255,255,255,0.7); margin-bottom: 8px; }
    .pay-recap .lines { display: flex; flex-direction: column; gap: 4px; }
    .pay-recap .line  { display: flex; justify-content: space-between; color: #e8eef5; }
    .pay-recap .total {
      display: flex; justify-content: space-between;
      margin-top: 10px; padding-top: 10px;
      border-top: 1px solid rgba(255,255,255,0.07);
      font-weight: 700; font-size: 1rem; color: #fff;
    }
    .pay-zone { padding: 24px; text-align: center; }
    .pay-open-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: #2563eb; color: #fff;
      padding: 13px 28px; border-radius: 999px;
      font-size: 1rem; font-weight: 600; text-decoration: none;
      border: none; cursor: pointer;
      transition: background .15s;
    }
    .pay-open-btn:hover { background: #1d4ed8; }
    .pay-open-btn:active { background: #1e40af; }
    .pay-open-btn:disabled { opacity: 0.6; cursor: wait; }
    .pay-message {
      padding: 24px;
      text-align: center;
    }
    .pay-message h2 { margin: 0 0 8px; font-size: 1.05rem; color: #fff; }
    .pay-message p { margin: 0; font-size: 0.9rem; color: rgba(255,255,255,0.65); }
    .pay-error-banner {
      padding: 12px 24px;
      background: rgba(239,68,68,0.1); border-bottom: 1px solid rgba(239,68,68,0.3);
      color: #f3b4b4; font-size: 0.85rem;
    }
  </style>
</head>
<body>
  <div class="pay-card">

    <div class="pay-header">
      <img src="<%= assets.media %>logo.svg" alt="BTS" onerror="this.style.display='none'">
      <% if (error === 'already_paid') { %>
        <p class="pay-title"><%= t('pay.alreadyPaidTitle') %></p>
      <% } else if (error === 'invalid_token' || error === 'order_not_payable') { %>
        <p class="pay-title"><%= t('pay.linkExpiredTitle') %></p>
      <% } else if (error === 'order_not_found') { %>
        <p class="pay-title"><%= t('pay.orderNotFoundTitle') %></p>
      <% } else if (error === 'seat_conflict') { %>
        <p class="pay-title"><%= t('pay.seatConflictTitle') %></p>
      <% } else { %>
        <p class="pay-title"><%= t('pay.resumeHeading') %></p>
        <p class="pay-lead"><%= t('pay.resumeLead') %></p>
      <% } %>
    </div>

    <% if (error === 'create_failed') { %>
      <div class="pay-error-banner"><%= t('pay.resumeCreateError') %></div>
    <% } %>

    <% if (error === 'already_paid') { %>
      <div class="pay-message"><p><%= t('pay.alreadyPaidBody') %></p></div>
    <% } else if (error === 'invalid_token' || error === 'order_not_payable') { %>
      <div class="pay-message"><p><%= t('pay.linkExpiredBody') %></p></div>
    <% } else if (error === 'order_not_found') { %>
      <div class="pay-message"><p><%= t('pay.orderNotFoundBody') %></p></div>
    <% } else if (error === 'seat_conflict') { %>
      <div class="pay-message"><p><%= t('pay.seatConflictBody') %></p></div>
    <% } else { %>
      <div class="pay-recap">
        <div class="desc"><%= description %></div>
        <% if (lines.length) { %>
        <div class="lines">
          <% lines.forEach(function(ln) { %>
          <div class="line">
            <span><%= ln.zoneKey %><% if (ln.seatId) { %> · <%= ln.seatId %><% } %> — <%= ln.tariffCode %></span>
            <span><%= formatCurrency(ln.priceCents) %></span>
          </div>
          <% }); %>
        </div>
        <% } %>
        <div class="total">
          <span><%= t('common.total') %></span>
          <span><%= formatCurrency(totalCents) %></span>
        </div>
      </div>

      <form class="pay-zone" method="post" action="">
        <input type="hidden" name="id" value="<%= id %>">
        <button type="submit" class="pay-open-btn" id="payNowBtn"><%= t('pay.payNow') %></button>
      </form>
    <% } %>

  </div>

  <script>
  (function () {
    var form = document.querySelector('form.pay-zone');
    if (!form) return;
    form.addEventListener('submit', function () {
      var btn = document.getElementById('payNowBtn');
      if (btn) { btn.disabled = true; btn.textContent = btn.textContent; }
    });
  })();
  </script>

</body>
</html>
