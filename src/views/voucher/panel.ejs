<%# Colonne de droite du plan pour le retrait d'un bon cadeau — remplace le
    panier/paiement de order/index.ejs. Rien à régler ici : le bon tient lieu de
    paiement, on ne collecte donc qu'un contact pour l'envoi des billets. %>
<div id="voucherPanel" class="block">
  <h2>Vos places</h2>
  <p class="help" id="vcLead"></p>

  <div id="vcBalance" class="voucher-balance-box"></div>
  <div id="vcSeats" class="vc-seats"></div>

  <div class="form-grid">
    <div class="form-group">
      <label for="vcLastName">Nom</label>
      <input type="text" id="vcLastName" autocomplete="family-name">
    </div>
    <div class="form-group">
      <label for="vcFirstName">Prénom</label>
      <input type="text" id="vcFirstName" autocomplete="given-name">
    </div>
    <div class="form-group">
      <label for="vcEmail">Email (réception des billets)</label>
      <input type="email" id="vcEmail" autocomplete="email" placeholder="email@exemple.com">
    </div>
  </div>

  <div class="total-actions">
    <div class="pay-action">
      <button type="button" id="vcConfirm" class="pay-btn" disabled>Recevoir mes billets</button>
    </div>
    <button type="button" id="vcReset" class="tool-btn vc-reset">Tout retirer</button>
  </div>

  <p id="vcMsg" class="feedback"></p>

  <p><small class="help">
    Vos billets vous seront envoyés par email. Aucun paiement n'est demandé :
    ces places sont offertes.
  </small></p>
</div>

<style>
  .voucher-balance-box {
    border: 1px solid rgba(255,255,255,0.14); border-radius: 10px;
    padding: 10px 12px; margin: 10px 0 12px; font-weight: 700;
  }
  .vc-seats { display: grid; gap: 8px; margin-bottom: 14px; }
  .vc-seat {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    padding: 9px 12px; border: 1px solid rgba(255,255,255,0.12); border-radius: 10px;
  }
  .vc-seat-id { font-weight: 800; letter-spacing: .04em; }
  .vc-drop { background: none; border: none; color: inherit; cursor: pointer; opacity: .7; font-size: 1rem; }
  .vc-drop:hover { opacity: 1; }
  .vc-hint { opacity: .65; font-size: .88rem; }
  .vc-reset { margin-left: 10px; }
</style>
