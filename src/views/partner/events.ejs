<!doctype html>
<%
  const normalizeBase = (value, fallback) => {
    if (!value) return fallback;
    const val = String(value);
    return val.endsWith('/') ? val : `${val}/`;
  };
  const staticBase = normalizeBase(
    (assets && typeof assets === 'object' && assets.static)
      ? assets.static
      : (typeof assets === 'string' ? assets : null),
    'static/'
  );
  const dynamicBase = normalizeBase(
    (assets && typeof assets === 'object' && assets.base)
      ? assets.base
      : null,
    'dynamic/'
  );
%>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <title><%= title || 'Billetterie Partenaire' %></title>
  <link rel="stylesheet" href="<%= staticBase %>styles/generic-view.css">
  <link rel="stylesheet" href="<%= staticBase %>styles/order.css">
  <style>
    .partner-events {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px 20px 40px;
    }
    .events-table {
      width: 100%;
      border-collapse: collapse;
      background: #0f1720;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 12px 32px rgba(0,0,0,0.35);
    }
    .events-table th,
    .events-table td {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      color: #e8eef5;
      text-align: left;
    }
    .events-table th {
      background: #111a24;
      text-transform: uppercase;
      letter-spacing: .08em;
      font-size: 0.8rem;
      color: rgba(255,255,255,0.7);
    }
    .events-table tr:last-child td { border-bottom: none; }
    .btn-status {
      padding: 8px 14px;
      border-radius: 10px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      text-decoration: none;
      display: inline-block;
      border: none;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(0,0,0,0.25);
    }
    .btn-open {
      background: #1abc63;
      color: #06120b;
      box-shadow: 0 10px 24px rgba(26,188,99,0.35);
    }
    .btn-close {
      background: #ff5252;
      color: #0f0a0a;
      opacity: 0.75;
      cursor: not-allowed;
      box-shadow: 0 10px 24px rgba(255,82,82,0.25);
    }
    .muted { color: rgba(255,255,255,0.55); }
    .token-note { color: rgba(255,255,255,0.7); margin-top: 6px; }
  </style>
</head>
<body class="order-view">
  <header class="site-header">
    <div class="header-row">
      <div class="brand">
        <% if (brand && brand.logo) { %>
          <img src="<%= brand.logo %>" alt="<%= brand.alt || 'Logo' %>" class="logo">
        <% } %>
        <h1 id="pageTitle"><%= title || 'Billetterie Partenaire' %></h1>
      </div>
    </div>
    <div class="lead">
      Accès dédié pour <strong><%= partner?.name || partner?.slug || 'votre partenaire' %></strong>.
    </div>
  </header>

  <main class="partner-events">
    <table class="events-table">
      <thead>
        <tr>
        <th>Événement</th>
        <th>Date</th>
        <th>Accès</th>
        </tr>
      </thead>
      <tbody>
        <% (events || []).forEach(ev => { %>
          <tr>
            <td><%= ev.name %> <span class="muted">(<%= ev.slug %>)</span></td>
            <td><%= ev.startsAt ? new Date(ev.startsAt).toLocaleString('fr-FR', { dateStyle:'medium', timeStyle:'short' }) : '' %></td>
            <td>
              <% if (ev.status === 'sale_opened' && ev.link) { %>
                <a class="btn-status btn-open" href="<%= ev.link %>">SALE OPENED</a>
              <% } else if (ev.status === 'presale_opened' && ev.link) { %>
                <a class="btn-status btn-open" href="<%= ev.link %>">PRESALE OPENED</a>
              <% } else if (ev.status === 'presale_quota_reached') { %>
                <span class="btn-status btn-close">PRESALE QUOTA REACHED</span>
              <% } else { %>
                <span class="btn-status btn-close">SALE CLOSED</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</body>
</html>
