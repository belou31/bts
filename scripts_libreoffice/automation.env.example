# Example automation.env
# Copy to ~/.config/bts/automation.env and edit per environment
AUTOMATION_JWT_SECRET=change-me
AUTOMATION_JWT_ISS=libreoffice
AUTOMATION_JWT_AUD=bts-automation
AUTOMATION_JWT_SCOPES=automation:jobs:write automation:jobs:run
BTS_BASE_URL=http://127.0.0.1:8080
# Optional defaults
BTS_EVENT_ORDERS_SHEET=EventOrders
BTS_EVENT_IMPORT_DRY_RUN=true
BTS_EVENT_IMPORT_FORCE=false
BTS_EVENT_IMPORT_SEND_EMAIL=false
BTS_TARIFF_CATALOG_SHEET=TariffCatalog
BTS_TARIFF_CATALOG_DRY_RUN=false
BTS_TARIFF_PRICES_SHEET=TariffPrices
BTS_TARIFF_PRICES_DRY_RUN=true
BTS_TARIFF_PRICES_APPEND=false
BTS_CONFIG_SHEET=BTS_Config
