############################################################
# BTS environment template
# Copy this file to .env and fill every value accordingly.
############################################################

# Application context
APP_ENV=development            # development | staging | production
APP_URL=http://localhost:8080  # Base public URL (include /bts for non-dev)
BASE_PATH=                     # Leave blank in dev, set to /bts in prod

# MongoDB connectivity
MONGO_URI=mongodb://127.0.0.1:27017/bts
MONGODB_DB=bts

# Authentication & security
JWT_SECRET=replace-with-strong-secret
ADMIN_TOKEN=                    # Optional bearer token for /admin
ADMIN_USER=                     # Optional basic auth user for /admin
ADMIN_PASS=                     # Optional basic auth password

# Payment providers
PAYMENT_PROVIDER=helloasso
# HelloAsso integration
HELLOASSO_API_URL=http://127.0.0.1:3005
HELLOASSO_RETURN_URL=http://localhost:8080/pay/return
# Legacy flag (kept for compatibility; no longer required)
# HELLOASSO_STUB=true

# SumUp integration
SUMUP_API_BASE=https://api.sumup.com/v0.1
SUMUP_TOKEN_URL=https://api.sumup.com/token
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_MERCHANT_CODE=
SUMUP_PAY_TO_EMAIL=
SUMUP_CURRENCY=EUR
SUMUP_RETURN_URL=http://localhost:8080/pay/return
SUMUP_CALLBACK_URL=http://localhost:8080/pay/webhook

# Misc
BASE_EMAIL=notifications@example.org
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
