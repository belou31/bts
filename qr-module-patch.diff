+// client-side script pour la page scan PWA
+// Nécessite la lib html5-qrcode (MIT) chargée via CDN (voir index.ejs).
+
+document.addEventListener('DOMContentLoaded', () => {
+  const eventIdInput = document.getElementById('eventId');
+  const tokenInput   = document.getElementById('token');
+  const startBtn     = document.getElementById('startBtn');
+  const stopBtn      = document.getElementById('stopBtn');
+  const statusEl     = document.getElementById('status');
+  const previewId    = 'preview';
+  let scanner        = null;
+
+  async function handleScan(value) {
+    const eventId = eventIdInput.value.trim();
+    const token   = tokenInput.value.trim();
+    if (!eventId || !token) {
+      statusEl.textContent = 'Renseignez un Event ID et un token.';
+      return;
+    }
+    try {
+      const res = await fetch(`${window.__BTS__.basePath}/api/scan`, {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+          'Authorization': `Bearer ${token}`
+        },
+        body: JSON.stringify({
+          value,
+          eventId,
+          deviceId: navigator.userAgent
+        })
+      });
+      const data = await res.json();
+      if (data.ok) {
+        statusEl.textContent = `✔️ Place ${data.ticket.seatId} reconnue.`;
+      } else {
+        statusEl.textContent = `❌ Erreur: ${data.reason || data.error}`;
+      }
+    } catch (e) {
+      statusEl.textContent = `⛔ Réseau impossible: ${e.message}`;
+    }
+  }
+
+  async function startScan() {
+    if (scanner) return; // déjà en cours
+    const { Html5Qrcode } = window; // la lib html5-qrcode est chargée globalement
+    if (!Html5Qrcode) {
+      statusEl.textContent = 'Bibliothèque QR non chargée.';
+      return;
+    }
+    scanner = new Html5Qrcode(previewId);
+    try {
+      await scanner.start(
+        { facingMode: 'environment' },
+        { fps: 10, qrbox: 250 },
+        async (decodedText) => {
+          // pause pour éviter de multiples lectures
+          await scanner.pause();
+          await handleScan(decodedText);
+          await scanner.resume();
+        },
+        (errorMessage) => {
+          console.debug('QR scan error:', errorMessage);
+        }
+      );
+      statusEl.textContent = 'Lecture en cours…';
+    } catch (err) {
+      statusEl.textContent = 'Impossible de démarrer la caméra: ' + err;
+      scanner = null;
+    }
+  }
+
+  async function stopScan() {
+    if (scanner) {
+      await scanner.stop();
+      scanner = null;
+      statusEl.textContent = 'Scan arrêté.';
+    }
+  }
+
+  startBtn.addEventListener('click', startScan);
+  stopBtn.addEventListener('click', stopScan);
+});
